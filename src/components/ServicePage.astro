---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import MotionController from "./MotionController.astro";
import ServiceVisual from "./ServiceVisual.astro";
import ArrowIcon from "./ArrowIcon.astro";
import { createWhatsAppUrl } from "../config/contact";
import { SITE_URL, services, servicePath, type ServiceDefinition } from "../config/site";

interface Props { service: ServiceDefinition }
const { service } = Astro.props;
const whatsappUrl = createWhatsAppUrl(service.message);
const relatedServices = service.related.map((slug) => services.find((item) => item.slug === slug)!);
const pageUrl = `${SITE_URL}${servicePath(service.slug)}`;
const schema = [
  {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.title,
    description: service.description,
    url: pageUrl,
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Country", name: "Uruguay" },
  },
  {
    "@type": "FAQPage",
    "@id": `${pageUrl}#faq`,
    mainEntity: service.questions.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout title={service.metaTitle} description={service.description} schema={schema}>
  <Header />
  <main id="main-content" tabindex="-1" class:list={["service-page", `service-page--${service.visual}`]}>
    <section class="service-hero" aria-labelledby="service-title">
      <div class="container service-hero-shell">
        <div class="service-hero-copy">
          <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/servicios/">Servicios</a><span aria-hidden="true">/</span><span>{service.eyebrow}</span></nav>
          <p class="eyebrow">{service.eyebrow} · {service.number}</p>
          <h1 id="service-title">{service.hero}</h1>
          <p class="service-summary">{service.summary}</p>
          <div class="service-hero-actions">
            <a class="button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Contanos tu proyecto <ArrowIcon /></a>
            <a class="button-secondary" href="#alcance">Ver qué puede incluir <ArrowIcon /></a>
          </div>
        </div>
        <div class="service-hero-art" data-reveal="mask"><ServiceVisual type={service.visual} label={service.title} /></div>
      </div>
    </section>

    <section class="service-principle" aria-labelledby="principle-title">
      <div class="container principle-shell">
        <p class="section-label">El enfoque</p>
        <h2 id="principle-title">{service.promise}</h2>
      </div>
    </section>

    <section id="alcance" class="service-scope" aria-labelledby="scope-title">
      <div class="container scope-shell">
        <div class="scope-audience">
          <p class="eyebrow">Para quién puede servir</p>
          <h2 id="scope-title">Una solución según el punto de partida.</h2>
          <ul>{service.audience.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="scope-includes">
          <p class="eyebrow">Qué puede incluir</p>
          <ol>{service.includes.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>)}</ol>
        </div>
      </div>
    </section>

    <section class="service-process" aria-labelledby="service-process-title">
      <div class="container">
        <div class="section-heading">
          <p class="section-label">Cómo lo abordamos</p>
          <h2 id="service-process-title">Claridad antes de sumar complejidad.</h2>
        </div>
        <ol class="process-list">
          {service.process.map((item, index) => <li data-reveal><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="service-solutions" aria-labelledby="solutions-title">
      <div class="container solutions-shell">
        <div>
          <p class="section-label">Posibles soluciones</p>
          <h2 id="solutions-title">El alcance se construye alrededor del objetivo.</h2>
        </div>
        <ul>{service.solutions.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>)}</ul>
      </div>
    </section>

    <section class="service-faq" aria-labelledby="faq-title">
      <div class="container faq-shell">
        <div><p class="section-label">Preguntas frecuentes</p><h2 id="faq-title">Antes de empezar.</h2></div>
        <div class="faq-list">
          {service.questions.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="related-services" aria-labelledby="related-title">
      <div class="container">
        <p class="section-label">Servicios relacionados</p>
        <h2 id="related-title">Una disciplina puede abrir la siguiente.</h2>
        <div class="related-list">
          {relatedServices.map((item) => <a href={servicePath(item.slug)}><span>{item.number}</span><strong>{item.title}</strong><ArrowIcon /></a>)}
        </div>
      </div>
    </section>

    <section class="service-cta-section" aria-labelledby="cta-title">
      <div class="container cta-shell">
        <p class="eyebrow">El próximo movimiento</p>
        <h2 id="cta-title">Contanos qué necesita tu proyecto.</h2>
        <p>Podemos empezar por una conversación simple y definir juntos el alcance adecuado.</p>
        <a class="button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Iniciar una conversación <ArrowIcon /></a>
      </div>
    </section>
  </main>
  <Footer />
  <MotionController />
</BaseLayout>

<style>
  .service-page { background:var(--color-cream); }
  .service-hero { position:relative; overflow:hidden; padding:calc(var(--header-height) + 86px) 0 clamp(95px,11vw,155px); background:linear-gradient(135deg,var(--color-cream),var(--color-stone)); }
  .service-hero::before { position:absolute; top:-28vw; right:-18vw; width:64vw; aspect-ratio:1; border:1px solid rgba(79,90,69,.2); border-radius:50%; content:""; }
  .service-hero-shell { position:relative; display:grid; grid-template-columns:minmax(0,1.02fr) minmax(420px,.78fr); gap:clamp(60px,8vw,130px); align-items:center; }
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:48px; color:rgba(44,46,38,.58); font-size:.68rem; }
  .breadcrumbs a { text-decoration:underline; text-underline-offset:3px; }
  .service-hero .eyebrow { margin-bottom:30px; }
  .service-hero h1 { max-width:820px; margin:0; font-size:clamp(5rem,8.6vw,9rem); font-style:italic; font-weight:400; line-height:.78; letter-spacing:-.048em; }
  .service-summary { max-width:650px; margin:38px 0 0; font-size:clamp(1.05rem,1.3vw,1.22rem); line-height:1.72; }
  .service-hero-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:34px; }
  .service-hero-art { min-width:0; }
  .service-principle { padding-block:clamp(100px,13vw,190px); background:var(--color-moss); color:var(--color-cream); }
  .principle-shell { display:grid; grid-template-columns:.27fr 1fr; gap:clamp(50px,8vw,130px); }
  .service-principle .section-label { color:rgba(243,239,231,.72); }
  .service-principle h2 { max-width:1040px; margin:0; font-size:var(--font-size-section-title); font-style:italic; font-weight:400; line-height:.87; letter-spacing:-.04em; }
  .service-scope { padding-block:clamp(100px,12vw,175px); }
  .scope-shell { display:grid; grid-template-columns:1fr 1fr; gap:clamp(60px,9vw,150px); }
  .scope-audience h2 { max-width:600px; margin:35px 0 54px; font-size:clamp(3.2rem,5vw,5.5rem); font-weight:400; line-height:.88; letter-spacing:-.04em; }
  .scope-audience ul { display:grid; gap:0; margin:0; padding:0; list-style:none; border-top:1px solid rgba(44,46,38,.22); }
  .scope-audience li { padding:18px 0 18px 22px; border-bottom:1px solid rgba(44,46,38,.22); line-height:1.55; }
  .scope-includes { padding:clamp(30px,4vw,58px); background:var(--color-stone); }
  .scope-includes ol { margin:42px 0 0; padding:0; list-style:none; }
  .scope-includes li { display:grid; grid-template-columns:42px 1fr; gap:16px; align-items:center; min-height:74px; border-bottom:1px solid rgba(44,46,38,.18); font-size:clamp(1rem,1.15vw,1.12rem); }
  .scope-includes li span { color:var(--color-olive); font-size:.66rem; font-weight:650; }
  .service-process { padding-block:clamp(100px,12vw,175px); background:var(--color-espresso); color:var(--color-cream); }
  .section-heading { display:grid; grid-template-columns:.27fr 1fr; gap:clamp(50px,8vw,130px); }
  .service-process .section-label { color:rgba(243,239,231,.7); }
  .section-heading h2 { max-width:900px; margin:0; font-size:var(--font-size-section-title); font-weight:400; line-height:.86; letter-spacing:-.04em; }
  .process-list { margin:clamp(75px,10vw,130px) 0 0; padding:0; list-style:none; border-top:1px solid rgba(243,239,231,.2); }
  .process-list li { display:grid; grid-template-columns:60px .7fr 1fr; gap:24px; align-items:center; min-height:116px; border-bottom:1px solid rgba(243,239,231,.2); }
  .process-list span { color:rgba(243,239,231,.48); font-size:.68rem; }
  .process-list h3 { margin:0; font-size:clamp(2.2rem,3.2vw,3.8rem); font-weight:400; }
  .process-list p { max-width:500px; margin:0; color:rgba(243,239,231,.67); line-height:1.65; }
  .service-solutions { padding-block:clamp(100px,12vw,175px); background:var(--color-stone); }
  .solutions-shell { display:grid; grid-template-columns:.8fr 1fr; gap:clamp(60px,9vw,150px); }
  .solutions-shell h2 { max-width:620px; margin:42px 0 0; font-size:clamp(3.5rem,5.8vw,6rem); font-style:italic; font-weight:400; line-height:.86; }
  .solutions-shell ul { margin:0; padding:0; list-style:none; border-top:1px solid rgba(44,46,38,.22); }
  .solutions-shell li { display:grid; grid-template-columns:45px 1fr; gap:20px; padding:24px 0; border-bottom:1px solid rgba(44,46,38,.22); }
  .solutions-shell li span { color:var(--color-olive); font-size:.68rem; }
  .solutions-shell li p { margin:0; font-size:clamp(1rem,1.25vw,1.18rem); line-height:1.65; }
  .service-faq { padding-block:clamp(100px,12vw,170px); }
  .faq-shell { display:grid; grid-template-columns:.7fr 1fr; gap:clamp(60px,9vw,150px); }
  .faq-shell h2 { margin:38px 0 0; font-size:clamp(4rem,6vw,6.5rem); font-style:italic; font-weight:400; line-height:.85; }
  .faq-list { border-top:1px solid rgba(44,46,38,.22); }
  .faq-list details { border-bottom:1px solid rgba(44,46,38,.22); }
  .faq-list summary { display:flex; justify-content:space-between; gap:25px; align-items:center; min-height:86px; padding:18px 0; cursor:pointer; list-style:none; font-weight:650; }
  .faq-list summary::-webkit-details-marker { display:none; }
  .faq-list summary span { font-size:1.35rem; transition:transform var(--transition-normal); }
  .faq-list details[open] summary span { transform:rotate(45deg); }
  .faq-list details p { max-width:650px; margin:0; padding:0 45px 26px 0; color:rgba(44,46,38,.7); line-height:1.7; }
  .related-services { padding-block:clamp(100px,11vw,155px); background:var(--color-moss); color:var(--color-cream); }
  .related-services .section-label { color:rgba(243,239,231,.7); }
  .related-services h2 { max-width:850px; margin:40px 0 68px; font-size:clamp(3.8rem,6.8vw,7rem); font-weight:400; line-height:.84; }
  .related-list { border-top:1px solid rgba(243,239,231,.24); }
  .related-list a { display:grid; grid-template-columns:50px 1fr 24px; gap:22px; align-items:center; min-height:112px; border-bottom:1px solid rgba(243,239,231,.24); transition:padding var(--transition-normal),background var(--transition-normal); }
  .related-list a:hover,.related-list a:focus-visible { padding-inline:20px; background:rgba(243,239,231,.06); }
  .related-list span { color:rgba(243,239,231,.5); font-size:.68rem; }
  .related-list strong { font-family:var(--font-heading); font-size:clamp(2.2rem,3.7vw,4.2rem); font-weight:400; }
  .service-cta-section { padding-block:clamp(110px,14vw,200px); background:var(--color-cream); text-align:center; }
  .cta-shell { display:flex; flex-direction:column; align-items:center; }
  .cta-shell h2 { max-width:1000px; margin:42px auto 28px; font-size:clamp(4.5rem,8vw,8.5rem); font-style:italic; font-weight:400; line-height:.8; }
  .cta-shell>p:not(.eyebrow) { max-width:560px; margin:0; line-height:1.7; }
  .cta-shell .button-primary { margin-top:34px; }
  @media(max-width:1000px){.service-hero-shell{grid-template-columns:1fr;}.service-hero-art{width:min(78vw,650px);margin:0 auto}.principle-shell,.section-heading{grid-template-columns:1fr;gap:38px}}
  @media(max-width:760px){.service-hero{padding-top:calc(var(--header-height) + 55px)}.breadcrumbs{margin-bottom:36px}.service-hero h1{font-size:clamp(4rem,15vw,6.2rem)}.service-hero-actions{display:grid;grid-template-columns:1fr}.service-hero-art{width:100%;margin-top:15px}.scope-shell,.solutions-shell,.faq-shell{grid-template-columns:1fr;gap:70px}.scope-includes{padding:28px 22px}.process-list li{grid-template-columns:34px 1fr;gap:14px;padding-block:24px}.process-list p{grid-column:2}.related-list a{grid-template-columns:34px 1fr 18px;min-height:96px}.service-principle h2,.section-heading h2{font-size:clamp(3.7rem,13vw,5.8rem)}.cta-shell h2{font-size:clamp(4rem,15vw,6rem)}}
  @media(max-width:420px){.service-hero h1{font-size:3.65rem}.service-summary{font-size:1rem}.service-principle h2,.section-heading h2{font-size:3.45rem}.scope-audience h2{font-size:3rem}.related-services h2{font-size:3.4rem}.related-list strong{font-size:2rem}.cta-shell h2{font-size:3.8rem}}
  @media(prefers-reduced-motion:reduce){.faq-list summary span,.related-list a{transition:none}}
</style>
