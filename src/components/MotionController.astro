<div class="custom-cursor" data-custom-cursor aria-hidden="true"><span></span></div>

<style>
  .custom-cursor { display:none; }

  @media (hover:hover) and (pointer:fine) {
    .custom-cursor {
      position:fixed;
      top:0;
      left:0;
      z-index:9999;
      width:28px;
      height:28px;
      display:grid;
      place-items:center;
      border:1px solid rgba(44,46,38,.48);
      border-radius:50%;
      opacity:0;
      pointer-events:none;
      transform:translate3d(var(--cursor-x,-50px),var(--cursor-y,-50px),0) translate(-50%,-50%) scale(var(--cursor-scale,1));
      transition:opacity 180ms ease,border-color 180ms ease,background-color 180ms ease;
      will-change:transform;
    }

    .custom-cursor span {
      width:4px;
      height:4px;
      border-radius:50%;
      background:var(--color-moss);
      transition:transform 180ms ease,background-color 180ms ease;
    }

    .custom-cursor.is-visible { opacity:1; }
    .custom-cursor.is-interactive { border-color:var(--color-moss); background:rgba(243,239,231,.58); --cursor-scale:1.35; }
    .custom-cursor.is-interactive span { transform:scale(.7); }
    .custom-cursor.is-pressed { --cursor-scale:.8; }
  }

  @media (prefers-reduced-motion:reduce) {
    .custom-cursor { display:none; }
  }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const revealElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-reveal]"),
  );
  const parallaxElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-parallax]"),
  );
  const tiltElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-tilt]"),
  );
  const scrollLinkedElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scroll-linked]"),
  );

  document.documentElement.classList.add("motion-ready");

  const revealAll = () => {
    revealElements.forEach((element) => element.classList.add("is-visible"));
  };

  if (reducedMotion.matches || !("IntersectionObserver" in window)) {
    revealAll();
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        rootMargin: "0px 0px -10%",
        threshold: 0,
      },
    );

    revealElements.forEach((element) => observer.observe(element));
  }

  let ticking = false;

  const updateParallax = () => {
    const viewportHeight = window.innerHeight;

    parallaxElements.forEach((element) => {
      const rect = element.getBoundingClientRect();
      const progress =
        (viewportHeight - rect.top) / (viewportHeight + rect.height) - 0.5;
      const offset = Math.max(-1, Math.min(1, progress)) * 42;

      element.style.setProperty("--parallax-offset", `${offset.toFixed(2)}px`);
    });

    scrollLinkedElements.forEach((element) => {
      const rect = element.getBoundingClientRect();
      const rawProgress = (viewportHeight - rect.top) / (viewportHeight + rect.height);
      const progress = Math.max(0, Math.min(1, rawProgress));
      element.style.setProperty("--scroll-progress", progress.toFixed(3));
      const travel = window.innerWidth < 560 ? 80 : 230;
      element.style.setProperty("--scroll-offset", `${(progress * travel).toFixed(2)}px`);
      element.style.setProperty("--scroll-inverse-offset", `${((progress - 1) * travel).toFixed(2)}px`);
      element.style.setProperty("--scroll-rotate", `${(progress * 180).toFixed(2)}deg`);
    });

    ticking = false;
  };

  const requestParallaxUpdate = () => {
    if (ticking || reducedMotion.matches) return;

    ticking = true;
    window.requestAnimationFrame(updateParallax);
  };

  if (!reducedMotion.matches && (parallaxElements.length > 0 || scrollLinkedElements.length > 0)) {
    updateParallax();
    window.addEventListener("scroll", requestParallaxUpdate, { passive: true });
    window.addEventListener("resize", requestParallaxUpdate);
  }

  if (
    !reducedMotion.matches &&
    window.matchMedia("(hover: hover) and (pointer: fine)").matches
  ) {
    const cursor = document.querySelector<HTMLElement>("[data-custom-cursor]");
    let cursorFrame = 0;
    let pointerX = -50;
    let pointerY = -50;

    const updateCursor = () => {
      cursor?.style.setProperty("--cursor-x", `${pointerX}px`);
      cursor?.style.setProperty("--cursor-y", `${pointerY}px`);
      cursorFrame = 0;
    };

    document.addEventListener("pointermove", (event) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      cursor?.classList.add("is-visible");
      if (!cursorFrame) cursorFrame = window.requestAnimationFrame(updateCursor);
    }, { passive: true });
    document.addEventListener("pointerover", (event) => {
      const target = event.target as Element | null;
      cursor?.classList.toggle("is-interactive", Boolean(target?.closest("a, button, summary, input, textarea, select")));
    });
    document.addEventListener("pointerdown", () => cursor?.classList.add("is-pressed"));
    document.addEventListener("pointerup", () => cursor?.classList.remove("is-pressed"));
    document.documentElement.addEventListener("mouseleave", () => cursor?.classList.remove("is-visible"));

    tiltElements.forEach((element) => {
      element.addEventListener("pointermove", (event) => {
        const bounds = element.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;

        element.style.setProperty("--tilt-x", `${(x * 3.4).toFixed(2)}deg`);
        element.style.setProperty("--tilt-y", `${(y * -3.4).toFixed(2)}deg`);
      });

      element.addEventListener("pointerleave", () => {
        element.style.setProperty("--tilt-x", "0deg");
        element.style.setProperty("--tilt-y", "0deg");
      });
    });
  }
</script>
