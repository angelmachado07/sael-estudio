---
import { Image } from "astro:assets";
import identidadMarca from "../assets/services/identidad-marca.png";
import disenoComunicacion from "../assets/services/diseno-comunicacion.png";
import webSoftware from "../assets/services/web-software.png";
import acompanamiento from "../assets/services/acompanamiento.png";

const services = [
  { title: "Identidad y marca", lead: "Una presencia que se reconoce.", description: "Estrategia, identidad visual y sistemas de marca pensados para crecer.", image: identidadMarca },
  { title: "Diseño y comunicación", lead: "Ideas que encuentran su forma.", description: "Dirección de arte, contenido, piezas y campañas para comunicar con coherencia.", image: disenoComunicacion },
  { title: "Web, apps y software", lead: "Diseño que también funciona.", description: "Experiencias, productos y sistemas digitales construidos con intención.", image: webSoftware },
  { title: "Acompañamiento y soluciones", lead: "El equipo que el proyecto necesita.", description: "Criterio, diseño y ejecución flexible para desafíos que no vienen en una caja.", image: acompanamiento },
];
---

<section id="servicios" class="services" aria-labelledby="services-title">
  <div class="container services-heading">
    <p class="section-label" data-reveal>Servicios</p>
    <h2 id="services-title" data-reveal="mask">Una necesidad.<br />Cuatro formas de avanzar.</h2>
  </div>

  <div class="service-panels" data-service-panels>
    {services.map((service,index)=>(
      <article class="service-panel" tabindex="0" data-service-panel style={`--panel:${index}`}>
        <span class="service-number">0{index+1}</span>

        <div class="service-visual" aria-hidden="true">
          <Image
            src={service.image}
            alt=""
            widths={[240, 360, 560]}
            sizes="(max-width: 680px) 80vw, (max-width: 940px) 42vw, 24vw"
            format="webp"
            quality={80}
            loading="lazy"
          />
        </div>

        <h3>{service.title}</h3>
        <div class="service-detail"><p>{service.lead}</p><p>{service.description}</p></div>
        <span class="service-arrow" aria-hidden="true">↗</span>
      </article>
    ))}
  </div>
</section>

<style>
  .services { position:relative; z-index:4; padding-top:clamp(110px,12vw,180px); background:var(--color-espresso); color:var(--color-cream); }
  .services-heading { display:grid; grid-template-columns:.32fr 1fr; gap:clamp(60px,8vw,130px); padding-bottom:clamp(80px,10vw,145px); }
  .services .section-label { color:rgba(243,239,231,.76); }
  .services h2 { margin:0; font-size:clamp(4.8rem,8.2vw,8.5rem); font-weight:500; line-height:.8; letter-spacing:-.065em; }
  .service-panels { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); min-height:min(86svh,860px); border-block:1px solid rgba(243,239,231,.2); transition:grid-template-columns 900ms var(--ease-out); }
  .service-panel { position:relative; min-width:0; display:grid; grid-template-rows:auto minmax(180px,1fr) auto auto; gap:clamp(24px,3vw,42px); overflow:hidden; padding:clamp(28px,3vw,48px); border-right:1px solid rgba(243,239,231,.18); outline-offset:-7px; transition:background-color 700ms var(--ease-out); }
  .service-panel:last-child { border-right:0; }
  .service-panel::before { content:""; position:absolute; inset:auto -20% -45% 35%; aspect-ratio:1; border:1px solid rgba(243,239,231,.14); border-radius:50%; transform:scale(.55); opacity:0; transition:transform 900ms var(--ease-out),opacity 700ms var(--ease-out); }
  .service-panel:hover,.service-panel:focus-visible { background:rgba(243,239,231,.07); }
  .service-panel:hover::before,.service-panel:focus-visible::before { transform:scale(1); opacity:1; }
  .service-panels:has(.service-panel:nth-child(1):hover),.service-panels:has(.service-panel:nth-child(1):focus-visible) { grid-template-columns:1.6fr .8fr .8fr .8fr; }
  .service-panels:has(.service-panel:nth-child(2):hover),.service-panels:has(.service-panel:nth-child(2):focus-visible) { grid-template-columns:.8fr 1.6fr .8fr .8fr; }
  .service-panels:has(.service-panel:nth-child(3):hover),.service-panels:has(.service-panel:nth-child(3):focus-visible) { grid-template-columns:.8fr .8fr 1.6fr .8fr; }
  .service-panels:has(.service-panel:nth-child(4):hover),.service-panels:has(.service-panel:nth-child(4):focus-visible) { grid-template-columns:.8fr .8fr .8fr 1.6fr; }
  .service-number { position:relative; z-index:2; font-size:var(--font-size-meta); opacity:.62; }
  .service-visual { position:relative; z-index:1; align-self:center; justify-self:center; width:min(100%,320px); aspect-ratio:1; overflow:hidden; border:1px solid rgba(243,239,231,.24); border-radius:2px; background:var(--color-cream); box-shadow:0 22px 54px rgba(0,0,0,.14); transition:transform 850ms var(--ease-out),opacity 650ms var(--ease-out); }
  .service-visual :global(img) { display:block; width:100%; height:100%; object-fit:cover; filter:saturate(.9) contrast(.98); transition:transform 1s var(--ease-out),filter 700ms ease; }
  .service-panel:hover .service-visual,.service-panel:focus-visible .service-visual { transform:scale(1.06); }
  .service-panel:hover .service-visual :global(img),.service-panel:focus-visible .service-visual :global(img) { transform:scale(1.035); filter:saturate(1) contrast(1); }
  .service-panels:has(.service-panel:hover) .service-panel:not(:hover) .service-visual,
  .service-panels:has(.service-panel:focus-visible) .service-panel:not(:focus-visible) .service-visual { opacity:.36; transform:scale(.82); }

  .service-panel h3 { position:relative; z-index:2; margin:0; font-size:clamp(2.25rem,3.5vw,4.4rem); font-weight:500; line-height:.88; letter-spacing:-.06em; transition:font-size 700ms var(--ease-out); }
  .service-panel:nth-child(4) h3 { font-size:clamp(1.95rem,2.25vw,3.15rem); }
  .service-panels:has(.service-panel:hover) .service-panel:not(:hover) h3,
  .service-panels:has(.service-panel:focus-visible) .service-panel:not(:focus-visible) h3 { font-size:1.7rem; }
  .service-panels:has(.service-panel:hover) .service-panel:nth-child(4):not(:hover) h3,
  .service-panels:has(.service-panel:focus-visible) .service-panel:nth-child(4):not(:focus-visible) h3 { font-size:1.4rem; }
  .service-detail { position:relative; z-index:2; min-width:225px; }
  .service-detail p:first-child { margin:0 0 12px; font-size:.96rem; font-weight:600; }
  .service-detail p:last-child { max-width:300px; margin:0; color:rgba(243,239,231,.68); font-size:.92rem; line-height:1.6; }
  .service-arrow { position:absolute; top:clamp(28px,3vw,48px); right:clamp(28px,3vw,48px); font-size:1rem; }
  @media (max-width:940px) { .service-panels { grid-template-columns:repeat(2,1fr)!important; } .service-panel { min-height:680px; border-bottom:1px solid rgba(243,239,231,.18); } .service-panel:nth-child(2) { border-right:0; } .service-visual { width:min(100%,360px); } }
  @media (max-width:680px) { .services-heading { grid-template-columns:1fr; gap:38px; } .services h2 { font-size:clamp(3.8rem,15.5vw,5rem); } .service-panels { grid-template-columns:1fr!important; } .service-panel { min-height:82svh; grid-template-rows:auto minmax(210px,1fr) auto auto; padding:30px var(--container-padding); border-right:0; } .service-visual { width:min(80vw,340px); } .service-panel h3 { font-size:clamp(3.1rem,12.5vw,4.1rem); } .service-panel:nth-child(4) h3 { font-size:clamp(2.4rem,10vw,3.1rem); } .service-detail { min-width:0; } }
  @media (prefers-reduced-motion:reduce) { .service-visual,.service-visual :global(img) { transition:none!important; } }
</style>
