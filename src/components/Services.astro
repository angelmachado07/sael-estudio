---
import { Image } from "astro:assets";
import ArrowIcon from "./ArrowIcon.astro";
import webSoftware from "../assets/services/web-software.png";
import identidadMarca from "../assets/services/identidad-marca.png";
import disenoComunicacion from "../assets/services/diseno-comunicacion.png";
import acompanamiento from "../assets/services/acompanamiento.png";
import { services, servicePath } from "../config/site";

const images = [webSoftware, identidadMarca, disenoComunicacion, acompanamiento];
const homeCopy = [
  {
    lead: "De una primera web a una solución a medida.",
    text: "Diseñamos y desarrollamos sitios web, aplicaciones, sistemas e integraciones alrededor de una necesidad concreta.",
    capabilities: ["Sitios y portfolios", "Apps y sistemas", "Software a medida"],
  },
  {
    lead: "Una marca clara para crecer con coherencia.",
    text: "Definimos estrategia, concepto e identidad visual para construir una presencia reconocible en cada punto de contacto.",
    capabilities: ["Estrategia", "Identidad visual", "Sistemas de marca"],
    note: "Presencia digital inicial puede combinar esta base de identidad con los primeros canales del proyecto.",
  },
  {
    lead: "Experiencias que se entienden y se recuerdan.",
    text: "Ordenamos información, recorridos y mensajes para convertirlos en interfaces, prototipos y piezas visuales claras.",
    capabilities: ["UX/UI", "Prototipos", "Comunicación visual"],
  },
  {
    lead: "Dirección para ordenar, lanzar y evolucionar.",
    text: "Articulamos prioridades, canales y herramientas para que la presencia digital avance como un sistema y no como tareas aisladas.",
    capabilities: ["Dirección digital", "Canales y lanzamiento", "Evolución"],
    note: "Presencia digital inicial acompaña a emprendimientos y profesionales que necesitan empezar con claridad.",
  },
];
---

<section id="servicios" class="services" aria-label="Servicios">
  <div class="service-chapters">
    {services.map((service, index) => {
      const copy = homeCopy[index];
      return (
        <article class="service-chapter" data-service-chapter>
          <div class="service-chapter-inner container">
            <div class="service-heading-copy" data-reveal>
              <p class="service-number">{index === 0 ? "Primer capítulo" : "Capítulo"} · {service.number}</p>
              <h2>{service.title}</h2>
            </div>

            <div class="service-visual" aria-hidden="true">
              <Image src={images[index]} alt="" widths={[480, 720, 960]} sizes="(max-width: 860px) calc(100vw - 40px), 46vw" format="webp" quality={82} loading="lazy" />
              <span class="service-visual-line"></span>
            </div>

            <div class="service-body" data-reveal>
              <p class="service-lead">{copy.lead}</p>
              <p class="service-description">{copy.text}</p>
              <ul class="service-capabilities" aria-label={`Qué puede incluir ${service.title}`}>
                {copy.capabilities.map((capability) => <li>{capability}</li>)}
              </ul>
              {copy.note && <p class="service-note"><strong>Presencia digital inicial</strong>{copy.note.replace("Presencia digital inicial", "")}</p>}
              <a class="service-cta" href={servicePath(service.slug)}>Conocer el servicio <ArrowIcon /></a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .services { position:relative; z-index:4; overflow:clip; background:var(--color-espresso); color:var(--color-cream); }
  .service-chapter { position:relative; display:flex; min-height:min(790px,92svh); isolation:isolate; }
  .service-chapter:not(:last-child)::after { position:absolute; right:8%; bottom:0; left:8%; height:1px; background:linear-gradient(90deg,transparent,rgba(243,239,231,.2) 12%,rgba(243,239,231,.2) 88%,transparent); content:""; }
  .service-chapter::before { position:absolute; inset:0; z-index:-1; background:linear-gradient(120deg,rgba(243,239,231,.045),transparent 45%); content:""; opacity:0; transition:opacity 800ms ease; }
  .service-chapter:nth-child(even)::before { background:linear-gradient(245deg,rgba(107,116,92,.2),transparent 52%); }
  .service-chapter.is-current::before { opacity:1; }
  .service-chapter-inner { display:grid; grid-template-columns:minmax(350px,.78fr) minmax(360px,.92fr); grid-template-areas:"heading visual" "body visual"; column-gap:clamp(64px,9vw,145px); align-items:center; padding-block:clamp(82px,9vw,128px); }
  .service-chapter:nth-child(even) .service-chapter-inner { grid-template-areas:"visual heading" "visual body"; }
  .service-heading-copy { grid-area:heading; align-self:end; max-width:590px; }
  .service-body { grid-area:body; align-self:start; max-width:570px; }
  .service-number { margin:0 0 clamp(24px,3vw,40px); color:rgba(243,239,231,.55); font-size:.68rem; font-weight:650; letter-spacing:.12em; text-transform:uppercase; }
  .service-heading-copy h2 { margin:0; font-size:var(--font-size-feature-title); font-weight:600; line-height:.84; letter-spacing:-.055em; }
  .service-visual { grid-area:visual; position:relative; justify-self:center; width:min(100%,570px); overflow:hidden; aspect-ratio:1.05; border-radius:clamp(16px,2vw,28px); background:var(--color-cream); box-shadow:0 32px 80px rgba(0,0,0,.22); opacity:1; clip-path:none; transform:none; transition:transform 800ms var(--ease-out),clip-path 1000ms var(--ease-in-out),opacity 600ms ease; }
  :global(html.motion-ready) .service-visual { opacity:.72; clip-path:inset(5% 7%); transform:translateY(22px) scale(.97); }
  .service-chapter.is-current .service-visual { opacity:1; clip-path:inset(0); transform:translateY(-5px); }
  .service-visual :global(img) { width:100%; height:100%; object-fit:contain; transform:scale(1.06); transition:transform 1100ms var(--ease-out); }
  .service-chapter.is-current .service-visual :global(img) { transform:scale(1.015); }
  .service-visual-line { position:absolute; z-index:2; right:22px; bottom:22px; width:30%; height:1px; background:var(--color-moss); transform:scaleX(.3); transform-origin:right; transition:transform 900ms var(--ease-out); }
  .service-chapter.is-current .service-visual-line { transform:scaleX(1); }
  .service-lead { margin:clamp(28px,3.4vw,46px) 0 12px; font-size:clamp(1.12rem,1.5vw,1.42rem); font-weight:650; line-height:1.35; }
  .service-description { margin:0; color:rgba(243,239,231,.72); line-height:1.7; }
  .service-capabilities { display:flex; flex-wrap:wrap; gap:8px; margin:25px 0 0; padding:0; list-style:none; }
  .service-capabilities li { padding:7px 11px; border:1px solid rgba(243,239,231,.2); border-radius:999px; color:rgba(243,239,231,.82); font-size:.72rem; font-weight:600; }
  .service-note { margin:22px 0 0; padding:17px 0 0 20px; border-top:1px solid rgba(243,239,231,.16); color:rgba(243,239,231,.7); font-size:.88rem; line-height:1.6; }
  .service-note strong { display:block; margin-bottom:5px; color:var(--color-cream); }
  .service-cta { display:inline-flex; align-items:center; justify-content:space-between; gap:28px; min-height:50px; margin-top:32px; padding:0 18px 0 20px; border:1px solid var(--color-cream); border-radius:999px; font-size:.78rem; font-weight:650; transition:background var(--transition-normal),color var(--transition-normal),transform var(--transition-normal); }
  .service-cta:hover,.service-cta:focus-visible { background:var(--color-cream); color:var(--color-espresso); transform:translateY(-3px); }
  @media(max-width:900px){.service-chapter{min-height:auto}.service-chapter-inner,.service-chapter:nth-child(even) .service-chapter-inner{grid-template-columns:1fr;grid-template-areas:"heading" "visual" "body";row-gap:36px;padding-block:78px}.service-heading-copy,.service-body{max-width:660px}.service-visual{width:min(76vw,520px)}.service-lead{margin-top:0}}
  @media(max-width:560px){.service-chapter-inner,.service-chapter:nth-child(even) .service-chapter-inner{row-gap:28px;padding-block:64px}.service-visual{width:min(82vw,330px);aspect-ratio:1}.service-cta{width:100%}}
  @media(prefers-reduced-motion:reduce){.service-chapter::before,.service-visual,.service-visual :global(img),.service-visual-line{transition:none}.service-visual{opacity:1;clip-path:none;transform:none}.service-visual :global(img){transform:none}}
</style>

<script>
  const serviceChapters = Array.from(document.querySelectorAll<HTMLElement>("[data-service-chapter]"));
  const serviceReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (serviceReducedMotion.matches || !("IntersectionObserver" in window)) {
    serviceChapters.forEach((chapter) => chapter.classList.add("is-current"));
  } else {
    const serviceObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.target.classList.toggle("is-current", entry.isIntersecting));
    }, { rootMargin: "-16% 0px -16%", threshold: .12 });
    serviceChapters.forEach((chapter) => serviceObserver.observe(chapter));
  }
</script>
