---
const services = [
  {
    number: "01",
    title: "Identidad visual",
    shortDescription:
      "Construimos la imagen visual de marcas y proyectos.",
    description:
      "Definimos una identidad clara, coherente y reconocible, capaz de expresar la esencia de una marca y sostener su comunicación en distintos formatos.",
    keywords: ["Concepto", "Logo", "Paleta", "Tipografía"],
  },
  {
    number: "02",
    title: "Diseño gráfico",
    shortDescription:
      "Diseñamos piezas visuales para comunicar mejor.",
    description:
      "Creamos materiales gráficos pensados para presentar, informar y comunicar con mayor claridad, intención y coherencia visual.",
    keywords: ["Papelería", "Redes", "Piezas", "Documentos"],
  },
  {
    number: "03",
    title: "Web y presencia digital",
    shortDescription:
      "Creamos y ordenamos la presencia digital de tu marca.",
    description:
      "Diseñamos páginas web y organizamos los principales canales digitales para construir una presencia online profesional, conectada y coherente.",
    keywords: ["Web", "WhatsApp", "Google", "Redes"],
  },
  {
    number: "04",
    title: "Acompañamiento creativo",
    shortDescription:
      "Ayudamos a ordenar ideas y darles dirección visual.",
    description:
      "Acompañamos procesos creativos para definir prioridades, tomar decisiones con criterio y transformar ideas dispersas en una dirección concreta.",
    keywords: ["Claridad", "Dirección", "Criterio", "Proceso"],
  },
];
---

<section
  id="servicios"
  class="services section"
  aria-labelledby="services-title"
>
  <div class="container">
    <div class="services-heading">
      <div>
        <p class="section-label">
          <span>03</span>
          Servicios
        </p>
      </div>

      <div class="services-heading-content">
        <h2 id="services-title">
          Soluciones visuales para marcas que buscan crecer con claridad.
        </h2>

        <p>
          Cada marca necesita algo distinto. Por eso, en Sael acompañamos
          desde la creación de una identidad visual hasta el diseño de piezas,
          la presencia digital y la definición creativa de un proyecto.
        </p>
      </div>
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <div class="service-card-header">
              <span class="service-number">{service.number}</span>

              <div class="service-icon" aria-hidden="true">
                <span></span>
                <i></i>
                <span></span>
              </div>
            </div>

            <div class="service-card-content">
              <h3>{service.title}</h3>

              <p class="service-short-description">
                {service.shortDescription}
              </p>

              <p class="service-description">
                {service.description}
              </p>
            </div>

            <ul class="service-keywords" aria-label={`Incluye ${service.title}`}>
              {
                service.keywords.map((keyword) => (
                  <li>{keyword}</li>
                ))
              }
            </ul>

            <a class="service-link" href="#contacto">
              <span>Ver más</span>
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .services-heading {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: clamp(40px, 8vw, 120px);
    align-items: start;
    margin-bottom: clamp(56px, 8vw, 96px);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 8px 0 0;
    color: var(--color-olive);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-label span {
    color: var(--color-text);
  }

  .services-heading-content {
    max-width: 980px;
  }

  h2 {
    margin-bottom: 30px;
    font-size: clamp(2.7rem, 5vw, 5.2rem);
    letter-spacing: -0.045em;
  }

  .services-heading-content > p {
    max-width: 690px;
    margin-bottom: 0;
    color: rgba(44, 46, 38, 0.72);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .service-card {
    min-height: 560px;
    display: flex;
    flex-direction: column;
    padding: clamp(30px, 4vw, 52px);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background-color: rgba(248, 245, 239, 0.58);
    transition:
      background-color var(--transition-normal),
      transform var(--transition-normal);
  }

  .service-card:hover {
    background-color: var(--color-surface);
  }

  .service-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 68px;
  }

  .service-number {
    color: var(--color-olive);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
  }

  .service-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
  }

  .service-icon span {
    width: 1px;
    height: 18px;
    background-color: var(--color-moss);
  }

  .service-icon i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-moss);
  }

  .service-card-content {
    flex-grow: 1;
  }

  h3 {
    max-width: 500px;
    margin-bottom: 20px;
    font-size: clamp(2rem, 3vw, 3.3rem);
    letter-spacing: -0.035em;
  }

  .service-short-description {
    max-width: 460px;
    margin-bottom: 24px;
    color: var(--color-moss);
    font-family: var(--font-heading);
    font-size: 1.4rem;
    line-height: 1.4;
  }

  .service-description {
    max-width: 520px;
    margin-bottom: 36px;
    color: rgba(44, 46, 38, 0.7);
    line-height: 1.75;
  }

  .service-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 0 0 38px;
    padding: 0;
    list-style: none;
  }

  .service-keywords li {
    padding: 7px 12px;
    border: 1px solid rgba(107, 116, 92, 0.35);
    border-radius: 999px;
    color: var(--color-olive);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .service-link span:last-child {
    font-size: 1.1rem;
    transition: transform var(--transition-fast);
  }

  .service-link:hover span:last-child {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .services-heading {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .services-heading {
      margin-bottom: 48px;
    }

    h2 {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .service-card {
      padding: 28px;
    }

    .service-card-header {
      margin-bottom: 48px;
    }

    h3 {
      font-size: 2.3rem;
    }

    .service-short-description {
      font-size: 1.28rem;
    }
  }
</style>