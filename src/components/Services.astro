---
import { Image } from "astro:assets";
import ArrowIcon from "./ArrowIcon.astro";
import identidadMarca from "../assets/services/identidad-marca.png";
import disenoComunicacion from "../assets/services/diseno-comunicacion.png";
import webSoftware from "../assets/services/web-software.png";
import acompanamiento from "../assets/services/acompanamiento.png";
import { createWhatsAppUrl } from "../config/contact";

const services = [
  { title: "Identidad y marca", lead: "Una presencia que se reconoce.", description: "Definimos la dirección visual de la marca y construimos un sistema capaz de sostenerla en el tiempo. Identidad, aplicaciones y lineamientos trabajan juntos para darle coherencia, personalidad y espacio para crecer.", capabilities: ["Identidad visual", "Sistemas de marca", "Aplicaciones"], message: "Hola, quiero consultar por un proyecto de identidad y marca.", image: identidadMarca },
  { title: "Diseño y comunicación", lead: "Ideas que encuentran su forma.", description: "Convertimos mensajes, campañas y contenidos en piezas claras y consistentes. Diseñamos recursos digitales e impresos que ayudan a comunicar mejor y mantienen una presencia cuidada en cada punto de contacto.", capabilities: ["Piezas y campañas", "Contenido visual", "Materiales de marca"], message: "Hola, quiero consultar por diseño y comunicación.", image: disenoComunicacion },
  { title: "Web, apps y software", lead: "De una presencia profesional a una solución a medida.", description: "Creamos landing pages, webs institucionales y portfolios para profesionales, estudios y pequeños negocios; también aplicaciones, sistemas internos y software a medida. Cuando el proyecto lo necesita, integramos estructura SEO, Google Business y Maps para construir una presencia digital coherente y mejor preparada para ser encontrada.", capabilities: ["Webs y portfolios", "Apps y sistemas", "SEO y presencia en Google"], note: "Una presencia profesional completa puede reunir identidad, web, portfolio, contacto y visibilidad local para presentar el trabajo con seriedad y facilitar nuevas consultas.", message: "Hola, quiero consultar por una solución web o digital.", image: webSoftware },
  { title: "Acompañamiento y soluciones", lead: "El equipo que el proyecto necesita.", description: "Acompañamos la puesta en marcha de proyectos que necesitan dirección, criterio y capacidad de ejecución. Ordenamos canales y prioridades, configuramos herramientas y coordinamos la implementación y el seguimiento; Google Business, presencia local, procesos o contactos se integran cuando aportan a la solución.", capabilities: ["Prioridades y canales", "Configuración e implementación", "Seguimiento adaptado"], message: "Hola, quiero consultar por acompañamiento y soluciones.", image: acompanamiento },
];
---

<section id="servicios" class="services" aria-labelledby="services-title">
  <div class="container services-heading">
    <p class="section-label" data-reveal>Servicios</p>
    <div>
      <h2 id="services-title" data-reveal="mask">Una necesidad.<br />Cuatro formas de avanzar.</h2>
      <p class="services-intro" data-reveal>Marca, comunicación y tecnología articuladas para resolver lo que cada proyecto necesita.</p>
    </div>
  </div>

  <div class="service-chapters">
    {services.map((service, index) => {
      const whatsappUrl = createWhatsAppUrl(service.message);
      return (
        <article class="service-chapter" data-service-chapter>
          <div class="service-chapter-inner container">
            <div class="service-visual" data-reveal={index % 2 === 0 ? "left" : undefined}>
              <span class="service-visual-index" aria-hidden="true">0{index + 1}</span>
              <Image src={service.image} alt={`Representación visual de ${service.title}`} widths={[480, 720, 960]} sizes="(max-width: 860px) calc(100vw - 40px), 48vw" format="webp" quality={84} loading="lazy" />
              <span class="service-visual-line" aria-hidden="true"></span>
            </div>

            <div class="service-copy" data-reveal>
              <p class="service-number">Servicio / 0{index + 1}</p>
              <h3>{service.title}</h3>
              <p class="service-lead">{service.lead}</p>
              <p class="service-description">{service.description}</p>
              <ul class="service-capabilities" aria-label={`Capacidades de ${service.title}`}>
                {service.capabilities.map((capability) => <li>{capability}</li>)}
              </ul>
              {service.note && <p class="service-note">{service.note}</p>}
              {whatsappUrl ? (
                <a class="service-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Pedir presupuesto <ArrowIcon /></a>
              ) : (
                <button class="service-cta is-pending" type="button" aria-disabled="true" title="Disponible cuando incorporemos el WhatsApp oficial">
                  Pedir presupuesto <ArrowIcon /><span>WhatsApp próximamente</span>
                </button>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .services { position:relative; z-index:4; padding-top:clamp(110px,12vw,180px); overflow:clip; background:var(--color-espresso); color:var(--color-cream); }
  .services-heading { display:grid; grid-template-columns:.32fr 1fr; gap:clamp(60px,8vw,130px); padding-bottom:clamp(88px,11vw,160px); }
  .services .section-label { color:rgba(243,239,231,.76); }
  .services-heading h2 { margin:0; max-width:970px; font-size:var(--font-size-section-title); font-weight:500; line-height:.84; letter-spacing:-.062em; }
  .services-intro { max-width:560px; margin:clamp(34px,4vw,58px) 0 0; color:rgba(243,239,231,.7); font-size:clamp(1rem,1.25vw,1.18rem); line-height:1.65; }
  .service-chapters { border-top:1px solid rgba(243,239,231,.2); }
  .service-chapter { position:relative; display:flex; min-height:min(880px,96svh); border-bottom:1px solid rgba(243,239,231,.2); isolation:isolate; }
  .service-chapter::before { content:""; position:absolute; inset:0; z-index:-1; background:linear-gradient(115deg,rgba(243,239,231,.045),transparent 44%); opacity:0; transition:opacity 900ms ease; }
  .service-chapter:nth-child(even)::before { background:linear-gradient(245deg,rgba(107,116,92,.18),transparent 48%); }
  .service-chapter.is-current::before { opacity:1; }
  .service-chapter-inner { display:grid; grid-template-columns:minmax(430px,1.08fr) minmax(350px,.72fr); gap:clamp(64px,9vw,150px); align-items:center; padding-block:clamp(84px,9vw,140px); }
  .service-chapter:nth-child(even) .service-visual { order:2; }
  .service-visual { position:relative; overflow:hidden; aspect-ratio:1.08; border:1px solid rgba(243,239,231,.24); background:var(--color-cream); box-shadow:0 32px 80px rgba(0,0,0,.2); transform-origin:center; transition:transform 1000ms var(--ease-out),box-shadow 1000ms ease; }
  .service-chapter.is-current .service-visual { transform:translateY(-6px) scale(1.012); box-shadow:0 42px 100px rgba(0,0,0,.27); }
  .service-visual::after { content:""; position:absolute; inset:0; border:clamp(7px,1vw,13px) solid rgba(44,46,38,.08); pointer-events:none; }
  .service-visual :global(img) { width:100%; height:100%; object-fit:contain; transform:scale(1.045); transition:transform 1400ms var(--ease-out),filter 900ms ease; }
  .service-chapter.is-current .service-visual :global(img) { transform:scale(1); filter:saturate(1.03) contrast(1.01); }
  .service-visual-index { position:absolute; z-index:2; top:20px; left:22px; display:grid; place-items:center; width:42px; aspect-ratio:1; border:1px solid rgba(44,46,38,.34); border-radius:50%; color:var(--color-espresso); font-size:var(--font-size-meta); background:rgba(243,239,231,.76); backdrop-filter:blur(8px); }
  .service-visual-line { position:absolute; z-index:2; right:22px; bottom:22px; width:clamp(70px,10vw,150px); height:1px; background:var(--color-moss); transform:scaleX(.35); transform-origin:right; transition:transform 1100ms var(--ease-out); }
  .service-visual-line::before { content:""; position:absolute; left:0; top:-4px; width:9px; height:9px; border:1px solid var(--color-moss); border-radius:50%; background:var(--color-cream); }
  .service-chapter.is-current .service-visual-line { transform:scaleX(1); }
  .service-copy { max-width:560px; }
  .service-number { margin:0 0 clamp(26px,3vw,44px); color:rgba(243,239,231,.56); font-size:var(--font-size-meta); letter-spacing:.05em; }
  .service-copy h3 { margin:0; font-size:var(--font-size-feature-title); font-weight:500; line-height:.9; letter-spacing:-.058em; }
  .service-lead { margin:clamp(28px,3.4vw,48px) 0 12px; font-size:clamp(1.15rem,1.5vw,1.45rem); font-weight:600; line-height:1.3; }
  .service-description { margin:0; color:rgba(243,239,231,.72); font-size:clamp(.98rem,1.08vw,1.08rem); line-height:1.68; }
  .service-capabilities { display:flex; flex-wrap:wrap; gap:8px; margin:26px 0 0; padding:0; list-style:none; }
  .service-capabilities li { padding:7px 11px; border:1px solid rgba(243,239,231,.22); border-radius:999px; color:rgba(243,239,231,.82); font-size:.76rem; font-weight:600; line-height:1.2; }
  .service-note { margin:22px 0 0; padding:16px 0 0 20px; border-top:1px solid rgba(243,239,231,.17); color:rgba(243,239,231,.75); font-size:.9rem; line-height:1.55; }
  .service-cta { display:inline-flex; align-items:center; justify-content:space-between; gap:28px; min-width:210px; min-height:52px; margin-top:clamp(30px,4vw,48px); padding:0 18px 0 21px; border:1px solid var(--color-cream); border-radius:999px; background:transparent; color:var(--color-cream); font-size:var(--font-size-ui); font-weight:600; cursor:pointer; transition:background-color var(--transition-normal),color var(--transition-normal),transform var(--transition-normal); }
  .service-cta:hover,.service-cta:focus-visible { background:var(--color-cream); color:var(--color-espresso); transform:translateY(-3px); }
  .service-cta.is-pending { position:relative; cursor:not-allowed; opacity:.72; }
  .service-cta.is-pending:hover { background:transparent; color:var(--color-cream); transform:none; }
  .service-cta > span { position:absolute; top:calc(100% + 8px); left:20px; color:rgba(243,239,231,.62); font-size:.7rem; font-weight:500; white-space:nowrap; }
  @media (max-width:1000px) { .service-chapter-inner{grid-template-columns:minmax(360px,1fr) minmax(310px,.8fr);gap:55px}.service-chapter{min-height:auto} }
  @media (max-width:860px) { .services-heading{grid-template-columns:1fr;gap:38px}.service-chapter-inner{grid-template-columns:1fr;gap:44px;padding-block:88px}.service-chapter:nth-child(even) .service-visual{order:initial}.service-visual{aspect-ratio:1.16}.service-copy{max-width:650px}.service-chapter.is-current .service-visual{transform:none} }
  @media (max-width:560px) { .services{padding-top:96px}.services-heading{padding-bottom:78px}.service-chapter-inner{gap:36px;padding-block:68px}.service-visual{aspect-ratio:1;margin-inline:calc(var(--container-padding) * -.15)}.service-copy h3{max-width:350px}.service-lead{margin-top:28px}.service-cta{width:100%;margin-top:36px}.service-note{padding-left:16px} }
  @media (prefers-reduced-motion:reduce) { .service-chapter::before,.service-visual,.service-visual :global(img),.service-visual-line,.service-cta{transition:none}.service-chapter.is-current .service-visual{transform:none}.service-visual :global(img),.service-chapter.is-current .service-visual :global(img){transform:none} }
</style>

<script>
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-service-chapter]"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (reducedMotion.matches || !("IntersectionObserver" in window)) {
    chapters.forEach((chapter) => chapter.classList.add("is-current"));
  } else {
    const chapterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.target.classList.toggle("is-current", entry.isIntersecting));
    }, { rootMargin: "-18% 0px -18%", threshold: .18 });
    chapters.forEach((chapter) => chapterObserver.observe(chapter));
  }
</script>
