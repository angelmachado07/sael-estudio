<section id="inicio" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-layer hero-base">
    <div class="hero-stage container">
      <p class="hero-kicker">Estudio creativo independiente</p>
      <h1 id="hero-title"><span>Diseñamos</span><span>soluciones.</span></h1>
      <div class="hero-footer">
        <p>Identidad, comunicación y tecnología para que cada proyecto pueda avanzar.</p>
        <a href="#contacto">Iniciar un proyecto <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>

  <div class="hero-layer hero-reveal" aria-hidden="true">
    <div class="hero-stage container">
      <p class="hero-kicker">Diseño + pensamiento + código</p>
      <h1><span>Diseñamos</span><span>soluciones.</span></h1>
      <div class="hero-footer"><p>La forma cambia. La intención permanece.</p></div>
    </div>
  </div>

  <div class="hero-coordinate" aria-hidden="true"><span></span><i></i></div>
  <p class="hero-hint" aria-hidden="true">Mové para explorar</p>
</section>

<style>
  .hero { --lens-x:68%; --lens-y:43%; --lens-size:31vw; position:relative; min-height:100svh; overflow:hidden; background:var(--color-stone); color:var(--color-espresso); }
  .hero-layer { position:absolute; inset:0; }
  .hero-base { background:var(--color-stone); }
  .hero-reveal { z-index:2; pointer-events:none; background:var(--color-moss); color:var(--color-cream); clip-path:circle(var(--lens-size) at var(--lens-x) var(--lens-y)); will-change:clip-path; }
  .hero-stage { position:relative; height:100%; min-height:100svh; padding-top:clamp(145px,16vh,190px); padding-bottom:38px; font-size:18px; }
  .hero-kicker { position:absolute; top:calc(var(--header-height) + 34px); left:0; margin:0; font-size:var(--font-size-ui); font-weight:600; }
  h1 { position:relative; z-index:1; margin:0; font-size:clamp(7.6rem,14.3vw,13.6rem); font-weight:550; line-height:.69; letter-spacing:-.078em; }
  h1 span { display:block; width:max-content; max-width:100%; }
  h1 span:first-child { padding-inline:0; border:0; border-radius:0; }
  h1 span:last-child { margin-top:.08em; margin-left:clamp(32px,10vw,156px); }
  .hero-footer { position:absolute; right:0; bottom:38px; left:0; display:flex; align-items:end; justify-content:space-between; gap:40px; }
  .hero-footer p { max-width:390px; margin:0; font-size:16px; line-height:1.6; }
  .hero-base .hero-footer p { position:relative; z-index:1; }
  .hero-footer a { display:inline-flex; align-items:center; justify-content:space-between; gap:34px; min-height:52px; padding:0 19px 0 22px; border:1px solid currentColor; border-radius:999px; font-size:var(--font-size-ui); font-weight:600; transition:background-color var(--transition-normal),color var(--transition-normal),transform var(--transition-normal); }
  .hero-base .hero-footer a { position:relative; z-index:4; background:rgba(243,239,231,.9); backdrop-filter:blur(10px); }
  .hero-footer a:hover { background:var(--color-espresso); color:var(--color-cream); transform:translateY(-3px); }
  .hero-reveal .hero-footer { justify-content:flex-start; }
  .hero-coordinate { position:absolute; z-index:3; left:var(--lens-x); top:var(--lens-y); width:44px; height:44px; pointer-events:none; transform:translate(-50%,-50%); transition:left 120ms linear,top 120ms linear; }
  .hero-coordinate::before,.hero-coordinate::after { content:""; position:absolute; background:rgba(243,239,231,.6); }
  .hero-coordinate::before { top:21px; left:-18px; width:80px; height:1px; }
  .hero-coordinate::after { left:21px; top:-18px; width:1px; height:80px; }
  .hero-coordinate i { position:absolute; inset:17px; border:1px solid var(--color-cream); border-radius:50%; }
  .hero-hint { position:absolute; z-index:3; right:var(--container-padding); bottom:108px; margin:0; font-size:var(--font-size-meta); font-weight:600; opacity:.52; transform:rotate(-90deg) translateX(100%); transform-origin:right bottom; }
  @media (max-width:900px) { .hero { --lens-x:70%; --lens-y:49%; --lens-size:38vw; } h1 { font-size:clamp(6.7rem,16.2vw,9rem); } }
  @media (max-width:680px) {
    .hero { --lens-x:72%; --lens-y:44%; --lens-size:43vw; }
    .hero-stage { padding-top:clamp(150px,21vh,188px); padding-bottom:28px; }
    .hero-kicker { top:calc(var(--header-height) + 30px); }
    h1 { font-size:clamp(4.1rem,19vw,5.4rem); line-height:.75; letter-spacing:-.072em; }
    h1 span:last-child { margin-top:.12em; margin-left:0; }
    .hero-footer { bottom:30px; flex-direction:column; align-items:flex-start; gap:24px; }
    .hero-footer p { max-width:310px; }
    .hero-footer a { width:100%; }
    .hero-reveal .hero-footer { display:none; }
    .hero-hint { display:none; }
  }
  @media (max-width:420px) { h1 { font-size:clamp(4rem,17.5vw,4.6rem); } }
  @media (prefers-reduced-motion:reduce) { .hero { --lens-x:72%; --lens-y:43%; --lens-size:29vw; } .hero-coordinate { display:none; } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (hero && !reduced.matches) {
    let targetX=68, targetY=43, currentX=68, currentY=43, frame=0;
    const render=()=>{
      currentX+=(targetX-currentX)*.12; currentY+=(targetY-currentY)*.12;
      hero.style.setProperty("--lens-x",`${currentX.toFixed(2)}%`);
      hero.style.setProperty("--lens-y",`${currentY.toFixed(2)}%`);
      if (Math.abs(targetX-currentX)>.05 || Math.abs(targetY-currentY)>.05) frame=requestAnimationFrame(render); else frame=0;
    };
    hero.addEventListener("pointermove",event=>{
      const bounds=hero.getBoundingClientRect();
      targetX=((event.clientX-bounds.left)/bounds.width)*100;
      targetY=((event.clientY-bounds.top)/bounds.height)*100;
      if (!frame) frame=requestAnimationFrame(render);
    });
    hero.addEventListener("pointerleave",()=>{ targetX=68; targetY=43; if (!frame) frame=requestAnimationFrame(render); });
    const updateLens=()=>{
      const progress=Math.max(0,Math.min(1,-hero.getBoundingClientRect().top/hero.offsetHeight));
      const base=window.innerWidth<680 ? 43 : 31;
      hero.style.setProperty("--lens-size",`${base + progress*70}vw`);
    };
    let scrollFrame=0;
    const requestLensUpdate=()=>{
      if (scrollFrame) return;
      scrollFrame=requestAnimationFrame(()=>{ updateLens(); scrollFrame=0; });
    };
    window.addEventListener("scroll",requestLensUpdate,{passive:true}); updateLens();
  }
</script>
