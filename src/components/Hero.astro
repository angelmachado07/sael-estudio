---
import ArrowIcon from "./ArrowIcon.astro";
import BrandMedallion from "./BrandMedallion.astro";
import { createWhatsAppUrl, PROJECT_WHATSAPP_MESSAGE } from "../config/contact";

const projectWhatsAppUrl = createWhatsAppUrl(PROJECT_WHATSAPP_MESSAGE);
const words = ["sitios web.", "aplicaciones.", "identidades.", "soluciones digitales."];
---

<section id="inicio" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-ambient" aria-hidden="true"><span></span><i></i></div>
  <div class="hero-brand-intro" aria-hidden="true" data-hero-brand>SAEL</div>

  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="hero-kicker">Estudio de diseño y tecnología · Uruguay</p>
      <h1 id="hero-title">
        <span class="hero-static">Diseñamos y desarrollamos</span>
        <span class="hero-words" data-hero-words>
          {words.map((word, index) => <span class:list={[{ "is-current": index === words.length - 1 }]} data-word={index}>{word}</span>)}
        </span>
      </h1>
      <p class="hero-description">Desde una identidad y sus primeros canales hasta una web, una app o un sistema completo. Construimos contigo la solución que tu proyecto necesita.</p>
      <div class="hero-actions">
        <a class="button-primary" href={projectWhatsAppUrl} target="_blank" rel="noopener noreferrer" aria-label="Contanos tu proyecto por WhatsApp (abre en una pestaña nueva)">Contanos tu proyecto <ArrowIcon /></a>
        <a class="button-secondary" href="#proyectos">Ver proyectos <ArrowIcon /></a>
      </div>
    </div>

    <div class="hero-object" data-medallion-zone>
      <BrandMedallion />
      <p aria-hidden="true"><span>SAEL / 02</span><i></i><span>DISEÑO + TECNOLOGÍA</span></p>
    </div>
  </div>

  <div class="hero-foot container" aria-hidden="true"><span>Marca</span><i></i><span>Diseño</span><i></i><span>Desarrollo</span></div>
</section>

<style>
  .hero { --hero-progress:0; position:relative; min-height:100svh; overflow:hidden; padding:calc(var(--header-height) + 76px) 0 clamp(42px,5vw,70px); background:linear-gradient(130deg,var(--color-cream) 0 36%,var(--color-stone) 100%); color:var(--color-espresso); isolation:isolate; }
  .hero::after { position:absolute; right:-20vw; bottom:-42vw; z-index:-1; width:72vw; aspect-ratio:1; border:1px solid rgba(79,90,69,.18); border-radius:50%; content:""; }
  .hero-ambient { position:absolute; inset:0; z-index:-1; opacity:.65; }
  .hero-ambient::before,.hero-ambient::after { position:absolute; background:rgba(79,90,69,.16); content:""; }
  .hero-ambient::before { top:0; bottom:0; left:64%; width:1px; }
  .hero-ambient::after { top:57%; right:0; left:0; height:1px; }
  .hero-ambient span { position:absolute; top:57%; left:64%; width:11px; height:11px; border-radius:50%; background:var(--color-moss); transform:translate(-50%,-50%); }
  .hero-ambient i { position:absolute; top:calc(57% - 70px); left:calc(64% - 70px); width:140px; aspect-ratio:1; border:1px dashed rgba(79,90,69,.2); border-radius:50%; animation:hero-orbit 18s linear infinite; }
  .hero-brand-intro { position:absolute; top:2vh; left:-.045em; z-index:-1; color:rgba(79,90,69,.07); font-family:var(--font-heading); font-size:min(35vw,34rem); line-height:.72; letter-spacing:-.085em; transform:translate3d(calc(var(--hero-progress) * 14vw),calc(var(--hero-progress) * -9vh),0) scale(calc(1 - var(--hero-progress) * .22)); transform-origin:left top; opacity:calc(1 - var(--hero-progress) * 1.5); pointer-events:none; }
  .hero-shell { position:relative; z-index:2; min-height:calc(100svh - var(--header-height) - 150px); display:grid; grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr); gap:clamp(38px,6vw,96px); align-items:center; }
  .hero-copy { max-width:920px; }
  .hero-kicker { margin:0 0 clamp(32px,4.8vh,58px); color:var(--color-moss); font-size:.78rem; font-weight:650; letter-spacing:.07em; text-transform:uppercase; }
  h1 { margin:0; line-height:.8; letter-spacing:-.052em; }
  .hero-static { display:block; font-family:var(--font-body); font-size:clamp(1.05rem,1.65vw,1.55rem); font-weight:650; letter-spacing:-.035em; line-height:1.1; }
  .hero-words { position:relative; display:block; min-height:1.08em; margin-top:.06em; font-size:clamp(5.6rem,10.7vw,11.2rem); font-style:italic; }
  .hero-words>span { display:none; width:max-content; max-width:100%; padding-right:.08em; }
  .hero-words>span:last-child { display:block; }
  .hero-words.is-sequencing>span { position:absolute; inset:0 auto auto 0; display:block; opacity:0; transform:translate3d(0,28%,0) skewY(3deg); transition:opacity 360ms ease,transform 760ms var(--ease-out); }
  .hero-words.is-sequencing>span.is-current { opacity:1; transform:none; }
  .hero-description { max-width:570px; margin:clamp(30px,4vw,52px) 0 0; font-size:clamp(1rem,1.2vw,1.16rem); line-height:1.7; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:34px; }
  .hero-object { position:relative; justify-self:end; align-self:center; }
  .hero-object>p { display:flex; align-items:center; gap:9px; margin:30px 0 0; color:rgba(44,46,38,.6); font-size:.58rem; font-weight:650; letter-spacing:.11em; }
  .hero-object>p i { flex:1; height:1px; background:rgba(44,46,38,.24); }
  .hero-foot { position:absolute; right:0; bottom:20px; left:0; display:flex; align-items:center; gap:16px; color:rgba(44,46,38,.48); font-size:.64rem; font-weight:650; letter-spacing:.1em; text-transform:uppercase; }
  .hero-foot i { flex:0 1 90px; height:1px; background:rgba(44,46,38,.24); }
  @keyframes hero-orbit { to { transform:rotate(360deg); } }
  @media(max-width:1000px){.hero{padding-top:calc(var(--header-height) + 58px)}.hero-shell{grid-template-columns:minmax(0,1.1fr) minmax(260px,.6fr)}.hero-words{font-size:clamp(5rem,10.5vw,7.4rem)}}
  @media(max-width:760px){.hero{min-height:auto;padding:calc(var(--header-height) + 52px) 0 76px}.hero::after{right:-48vw;bottom:-30vw;width:125vw}.hero-ambient::before{left:78%}.hero-ambient::after{top:62%}.hero-ambient span{top:62%;left:78%}.hero-ambient i{display:none}.hero-brand-intro{top:11vh;font-size:55vw}.hero-shell{min-height:0;grid-template-columns:1fr;gap:42px}.hero-copy{display:contents}.hero-kicker{order:1;margin-bottom:0}.hero-copy h1{order:2}.hero-description{order:3;margin-top:0}.hero-actions{order:5;margin-top:0}.hero-object{order:4;justify-self:center;margin-block:6px}.hero-static{font-size:.98rem}.hero-words{font-size:clamp(4.3rem,18vw,6rem);min-height:1.82em;line-height:.84}.hero-words>span{width:min-content;max-width:100%}.hero-actions{display:grid;grid-template-columns:1fr 1fr;width:100%}.hero-actions a{padding-inline:16px}.hero-foot{display:none}}
  @media(max-width:480px){.hero{padding-bottom:62px}.hero-words{font-size:clamp(3.8rem,17vw,4.8rem)}.hero-description{font-size:.96rem}.hero-actions{grid-template-columns:1fr}.hero-object>p{display:none}}
  @media(prefers-reduced-motion:reduce){.hero-brand-intro{transform:none;opacity:.07}.hero-ambient i{animation:none}.hero-words.is-sequencing>span{transition:none}.hero-words.is-sequencing>span:not(:last-child){display:none}.hero-words.is-sequencing>span:last-child{position:static;display:block;opacity:1;transform:none}}
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const wordGroup = hero?.querySelector<HTMLElement>("[data-hero-words]");
  const wordElements = Array.from(wordGroup?.querySelectorAll<HTMLElement>("[data-word]") ?? []);
  const medallionZone = hero?.querySelector<HTMLElement>("[data-medallion-zone]");
  const medallion = hero?.querySelector<HTMLElement>("[data-medallion]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const precisePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

  if (wordGroup && wordElements.length && !reducedMotion.matches) {
    wordGroup.classList.add("is-sequencing");
    wordElements.forEach((word) => word.classList.remove("is-current"));
    let activeWord = 0;
    wordElements[activeWord].classList.add("is-current");
    const advanceWord = () => {
      wordElements[activeWord].classList.remove("is-current");
      activeWord += 1;
      wordElements[activeWord].classList.add("is-current");
      if (activeWord < wordElements.length - 1) window.setTimeout(advanceWord, 1150);
    };
    window.setTimeout(advanceWord, 1250);
  }

  if (hero && !reducedMotion.matches) {
    let scrollFrame = 0;
    const updateHero = () => {
      const progress = Math.max(0, Math.min(1, window.scrollY / Math.max(1, hero.offsetHeight * .55)));
      hero.style.setProperty("--hero-progress", progress.toFixed(3));
      scrollFrame = 0;
    };
    window.addEventListener("scroll", () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateHero);
    }, { passive: true });
    updateHero();
  }

  if (medallionZone && medallion && precisePointer.matches && !reducedMotion.matches) {
    let pointerFrame = 0;
    let nextX = 0;
    let nextY = 0;
    medallionZone.addEventListener("pointermove", (event) => {
      const bounds = medallionZone.getBoundingClientRect();
      nextX = (event.clientX - bounds.left) / bounds.width - .5;
      nextY = (event.clientY - bounds.top) / bounds.height - .5;
      if (pointerFrame) return;
      pointerFrame = window.requestAnimationFrame(() => {
        medallion.style.setProperty("--medallion-x", `${(nextX * 12).toFixed(2)}deg`);
        medallion.style.setProperty("--medallion-y", `${(nextY * -10).toFixed(2)}deg`);
        pointerFrame = 0;
      });
    });
    medallionZone.addEventListener("pointerleave", () => {
      medallion.style.setProperty("--medallion-x", "0deg");
      medallion.style.setProperty("--medallion-y", "0deg");
    });
  }
</script>
