---
import ArrowIcon from "../ArrowIcon.astro";
import { createWhatsAppUrl, GENERAL_WHATSAPP_MESSAGE } from "../../config/contact";

const whatsappUrl = createWhatsAppUrl(GENERAL_WHATSAPP_MESSAGE);
---

<header class="prototype-header" data-prototype-header aria-label="Navegación del prototipo v3">
  <div class="prototype-header-shell">
    <a class="prototype-brand" data-prototype-header-brand href="/" aria-label="Ir al inicio de Sael Estudio">
      <img
        src="/brand/sael-monogram-official-transparent.png"
        width="634"
        height="547"
        alt=""
      />
      <span>Sael</span><i aria-hidden="true"></i><small>Estudio</small>
    </a>

    <nav class="prototype-desktop-nav" aria-label="Navegación principal">
      <a href="/#sobre-sael">Estudio</a>
      <a href="/servicios/">Servicios</a>
      <a href="/#proyectos">Proyectos</a>
      <a href="/#proceso">Proceso</a>
    </nav>

    <a class="prototype-contact" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      Contanos tu proyecto <ArrowIcon />
    </a>

    <details class="prototype-mobile-menu" data-prototype-mobile-menu>
      <summary aria-label="Abrir menú de navegación">
        <span>Menú</span><i aria-hidden="true"></i>
      </summary>
      <div class="prototype-mobile-panel">
        <nav aria-label="Navegación móvil">
          <a href="/"><span>01</span>Inicio</a>
          <a href="/#sobre-sael"><span>02</span>Estudio</a>
          <a href="/servicios/"><span>03</span>Servicios</a>
          <a href="/#proyectos"><span>04</span>Proyectos</a>
          <a href="/#contacto"><span>05</span>Contacto</a>
        </nav>
        <a class="prototype-mobile-contact" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Contanos tu proyecto <ArrowIcon />
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  .prototype-header {
    position:fixed;
    inset:12px 0 auto;
    z-index:100;
    color:#2c2e26;
    visibility:hidden;
    opacity:0;
    transform:translateY(-22px) scale(.985);
    pointer-events:none;
    transition:opacity 420ms ease,visibility 420ms ease,transform 600ms cubic-bezier(.16,1,.3,1);
  }

  .prototype-header[data-visible="true"] {
    visibility:visible;
    opacity:1;
    transform:none;
    pointer-events:auto;
  }

  .prototype-header-shell {
    width:min(calc(100% - 40px),1180px);
    height:62px;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    margin-inline:auto;
    padding-inline:16px;
    border:1px solid rgba(44,46,38,.15);
    border-radius:999px;
    background:rgba(243,239,231,.92);
    box-shadow:0 14px 45px rgba(44,46,38,.11);
    backdrop-filter:blur(18px);
  }

  .prototype-brand {
    position:relative;
    z-index:5;
    justify-self:start;
    display:inline-flex;
    align-items:center;
    gap:8px;
    min-height:44px;
    font-family:"Bricolage Grotesque",Arial,sans-serif;
    font-weight:650;
  }

  .prototype-brand img { width:34px; height:30px; object-fit:contain; }
  .prototype-brand>span { font-size:1.45rem; line-height:1; letter-spacing:-.045em; }
  .prototype-brand>i { width:4px; height:4px; border-radius:50%; background:currentColor; }
  .prototype-brand>small { font:600 .7rem/1 Manrope,Arial,sans-serif; }
  .prototype-desktop-nav { display:flex; align-items:center; gap:2px; }
  .prototype-desktop-nav a { min-height:42px; display:flex; align-items:center; padding:0 14px; border-radius:999px; font-size:.76rem; font-weight:650; transition:background 220ms ease,color 220ms ease; }
  .prototype-desktop-nav a:hover,.prototype-desktop-nav a:focus-visible { background:#2c2e26; color:#f3efe7; }
  .prototype-contact { justify-self:end; min-height:44px; display:inline-flex; align-items:center; gap:18px; padding:0 15px 0 18px; border:1px solid currentColor; border-radius:999px; font-size:.74rem; font-weight:650; transition:background 220ms ease,color 220ms ease,transform 220ms ease; }
  .prototype-contact:hover,.prototype-contact:focus-visible { background:#2c2e26; color:#f3efe7; transform:translateY(-2px); }
  .prototype-mobile-menu { display:none; justify-self:end; }
  .prototype-mobile-menu summary { position:relative; z-index:4; min-width:96px; min-height:44px; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:0 15px; border:1px solid currentColor; border-radius:999px; cursor:pointer; list-style:none; font-size:.76rem; font-weight:650; }
  .prototype-mobile-menu summary::-webkit-details-marker { display:none; }
  .prototype-mobile-menu summary i { position:relative; width:18px; height:12px; }
  .prototype-mobile-menu summary i::before,.prototype-mobile-menu summary i::after { position:absolute; left:0; width:18px; height:1px; background:currentColor; content:""; transition:top 220ms ease,transform 220ms ease; }
  .prototype-mobile-menu summary i::before { top:3px; }
  .prototype-mobile-menu summary i::after { top:9px; }
  .prototype-mobile-menu[open] summary i::before { top:6px; transform:rotate(45deg); }
  .prototype-mobile-menu[open] summary i::after { top:6px; transform:rotate(-45deg); }
  .prototype-mobile-menu:not([open]) .prototype-mobile-panel { display:none; }
  .prototype-mobile-panel { position:fixed; inset:-12px 0 0; min-height:100svh; display:grid; grid-template-rows:1fr auto; gap:30px; overflow:auto; padding:125px 24px 34px; background:#2c2e26; color:#f3efe7; }
  .prototype-mobile-panel nav { display:grid; align-content:start; }
  .prototype-mobile-panel nav>a { display:grid; grid-template-columns:38px 1fr; align-items:baseline; padding:17px 0; border-bottom:1px solid rgba(243,239,231,.17); font:550 clamp(2.8rem,12vw,4.8rem)/.9 "Bricolage Grotesque",Arial,sans-serif; letter-spacing:-.045em; }
  .prototype-mobile-panel nav>a span { font:600 .65rem/1 Manrope,Arial,sans-serif; opacity:.5; }
  .prototype-mobile-contact { width:max-content; min-height:48px; display:inline-flex; align-items:center; gap:22px; padding:0 18px; border:1px solid rgba(243,239,231,.55); border-radius:999px; font-size:.76rem; font-weight:650; }
  .prototype-mobile-menu[open] summary { color:#f3efe7; }
  .prototype-header:has(.prototype-mobile-menu[open]) .prototype-brand { color:#f3efe7; }
  .prototype-header:has(.prototype-mobile-menu[open]) .prototype-brand img { padding:3px; border-radius:7px; background:#f3efe7; }

  @media(max-width:980px){
    .prototype-header-shell{grid-template-columns:1fr auto}
    .prototype-desktop-nav,.prototype-contact{display:none}
    .prototype-mobile-menu{display:block}
  }

  @media(max-width:520px){
    .prototype-header{top:8px}
    .prototype-header-shell{width:calc(100% - 24px);height:58px;padding-inline:12px}
    .prototype-brand>small,.prototype-brand>i{display:none}
    .prototype-brand img{width:32px;height:28px}
    .prototype-brand>span{font-size:1.32rem}
  }

  @media(prefers-reduced-motion:reduce){
    .prototype-header,.prototype-contact,.prototype-mobile-menu summary i::before,.prototype-mobile-menu summary i::after{transition:none}
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-prototype-mobile-menu]");

  if (menu) {
    const summary = menu.querySelector<HTMLElement>("summary");
    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>("a[href]"));
    const syncMenu = () => {
      document.body.classList.toggle("prototype-menu-open", menu.open);
      summary?.setAttribute("aria-label", menu.open ? "Cerrar menú de navegación" : "Abrir menú de navegación");
    };
    const closeMenu = (restoreFocus = false) => {
      menu.open = false;
      syncMenu();
      if (restoreFocus) summary?.focus();
    };

    links.forEach((link) => link.addEventListener("click", () => closeMenu()));
    menu.addEventListener("toggle", syncMenu);
    document.addEventListener("keydown", (event) => {
      if (!menu.open) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (event.key !== "Tab" || !summary || links.length === 0) return;
      const lastLink = links.at(-1);
      if (event.shiftKey && document.activeElement === summary) {
        event.preventDefault();
        lastLink?.focus();
      } else if (!event.shiftKey && document.activeElement === lastLink) {
        event.preventDefault();
        summary.focus();
      }
    });
    syncMenu();
  }
</script>
