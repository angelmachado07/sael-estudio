<div class="prototype-medallion-stage" data-prototype-medallion aria-hidden="true">
  <div class="prototype-medallion">
    <span class="prototype-disc prototype-disc--back"></span>
    <span class="prototype-disc prototype-disc--middle"></span>
    <span class="prototype-disc prototype-disc--front">
      <img
        src="/brand/sael-monogram-official-transparent.png"
        width="634"
        height="547"
        alt=""
      />
    </span>
  </div>
</div>

<style>
  .prototype-medallion-stage {
    position:relative;
    width:min(42vw,570px);
    aspect-ratio:1;
    perspective:1200px;
  }

  .prototype-medallion-stage::before {
    position:absolute;
    inset:73% 10% 4%;
    border-radius:50%;
    background:rgba(44,46,38,.25);
    filter:blur(28px);
    content:"";
    transform:scaleX(.86);
  }

  .prototype-medallion {
    position:absolute;
    inset:10% 8% 8% 9%;
    transform:rotateX(var(--medallion-tilt-y,-7deg)) rotateY(var(--medallion-tilt-x,8deg));
    transform-style:preserve-3d;
    animation:prototype-float 6.5s ease-in-out infinite;
    will-change:transform;
  }

  .prototype-disc {
    position:absolute;
    inset:0;
    display:grid;
    place-items:center;
    border-radius:50%;
    backface-visibility:hidden;
  }

  .prototype-disc--back {
    background:#2c2e26;
    box-shadow:0 34px 56px rgba(44,46,38,.24);
    transform:translate3d(18px,24px,-34px);
  }

  .prototype-disc--middle {
    background:#4f5a45;
    box-shadow:inset 0 1px 1px rgba(243,239,231,.14);
    transform:translate3d(9px,12px,-17px);
  }

  .prototype-disc--front {
    overflow:hidden;
    border:1px solid rgba(44,46,38,.12);
    background:
      radial-gradient(circle at 31% 23%,rgba(255,255,255,.65),transparent 35%),
      linear-gradient(145deg,#f3efe7,#d8d2c4);
    box-shadow:
      inset -18px -22px 38px rgba(107,116,92,.12),
      inset 10px 12px 30px rgba(255,255,255,.52),
      0 18px 38px rgba(44,46,38,.13);
    transform:translateZ(0);
  }

  .prototype-disc--front::after {
    position:absolute;
    inset:0;
    background:linear-gradient(112deg,rgba(255,255,255,.2),transparent 40% 70%,rgba(79,90,69,.08));
    content:"";
    pointer-events:none;
  }

  .prototype-disc img {
    width:57%;
    height:auto;
    object-fit:contain;
    filter:drop-shadow(0 7px 7px rgba(44,46,38,.08));
  }

  @keyframes prototype-float {
    0%,100% { translate:0 0; }
    50% { translate:0 -10px; }
  }

  @media(max-width:900px){
    .prototype-medallion-stage{width:min(74vw,540px)}
  }

  @media(max-width:520px){
    .prototype-medallion-stage{width:min(91vw,430px)}
    .prototype-medallion{inset:11% 9% 9% 10%}
    .prototype-disc--back{transform:translate3d(11px,15px,-24px)}
    .prototype-disc--middle{transform:translate3d(6px,8px,-12px)}
  }

  @media(prefers-reduced-motion:reduce){
    .prototype-medallion{animation:none;transform:rotateX(-5deg) rotateY(5deg)}
  }
</style>

<script>
  const medallionStage = document.querySelector<HTMLElement>("[data-prototype-medallion]");
  const precisePointer = window.matchMedia("(hover:hover) and (pointer:fine)");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion:reduce)");

  if (medallionStage && precisePointer.matches && !reducedMotion.matches) {
    let pointerFrame = 0;
    let tiltX = 8;
    let tiltY = -7;
    const renderTilt = () => {
      medallionStage.style.setProperty("--medallion-tilt-x", `${tiltX.toFixed(2)}deg`);
      medallionStage.style.setProperty("--medallion-tilt-y", `${tiltY.toFixed(2)}deg`);
      pointerFrame = 0;
    };
    medallionStage.addEventListener("pointermove", (event) => {
      const bounds = medallionStage.getBoundingClientRect();
      tiltX = ((event.clientX - bounds.left) / bounds.width - .5) * 12;
      tiltY = ((event.clientY - bounds.top) / bounds.height - .5) * -12;
      if (!pointerFrame) pointerFrame = window.requestAnimationFrame(renderTilt);
    });
    medallionStage.addEventListener("pointerleave", () => {
      tiltX = 8;
      tiltY = -7;
      if (!pointerFrame) pointerFrame = window.requestAnimationFrame(renderTilt);
    });
  }
</script>
