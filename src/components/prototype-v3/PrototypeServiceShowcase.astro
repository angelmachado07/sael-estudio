---
import { Image } from "astro:assets";
import webSoftware from "../../assets/services/web-software.png";
import identidadMarca from "../../assets/services/identidad-marca.png";
import disenoComunicacion from "../../assets/services/diseno-comunicacion.png";
import acompanamiento from "../../assets/services/acompanamiento.png";

const serviceImages = [
  { src:webSoftware, className:"is-web", label:"Web, apps y software" },
  { src:identidadMarca, className:"is-brand", label:"Identidad y estrategia de marca" },
  { src:disenoComunicacion, className:"is-design", label:"UX/UI y comunicación visual" },
  { src:acompanamiento, className:"is-guidance", label:"Acompañamiento creativo y digital" },
];
---

<div class="prototype-showcase" data-prototype-showcase role="group" aria-label="Imágenes de los servicios de Sael Estudio">
  <div class="prototype-showcase-stage">
    {serviceImages.map((image, index) => (
      <button
        type="button"
        class:list={["prototype-showcase-card", image.className, { "is-featured": index === 0 }]}
        data-showcase-card
        aria-label={`Destacar ${image.label}`}
        aria-pressed={index === 0 ? "true" : "false"}
        style={`--stack-order:${index + 1}`}
      >
        <Image
          src={image.src}
          alt=""
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 520px) 70vw, (max-width: 900px) 50vw, 30vw"
          format="webp"
          quality={84}
          loading="eager"
        />
      </button>
    ))}
  </div>
</div>

<style>
  .prototype-showcase {
    position:relative;
    width:min(43vw,610px);
    aspect-ratio:1;
    perspective:1300px;
  }

  .prototype-showcase::before {
    position:absolute;
    inset:71% 7% 7%;
    border-radius:50%;
    background:rgba(44,46,38,.23);
    filter:blur(30px);
    content:"";
    transform:scaleX(.84);
  }

  .prototype-showcase-stage {
    position:absolute;
    inset:3%;
    transform:rotateX(var(--showcase-y,-2deg)) rotateY(var(--showcase-x,2deg));
    transform-style:preserve-3d;
    transition:transform 500ms cubic-bezier(.16,1,.3,1);
  }

  .prototype-showcase-card {
    --rotation:0deg;
    position:absolute;
    display:block;
    overflow:hidden;
    margin:0;
    padding:0;
    border:1px solid rgba(44,46,38,.14);
    border-radius:var(--card-radius,clamp(14px,2vw,25px));
    background:#f3efe7;
    box-shadow:0 22px 48px rgba(44,46,38,.18);
    cursor:pointer;
    z-index:var(--stack-order,1);
    transform:translate3d(0,var(--float,0),var(--depth,0)) rotate(var(--rotation)) scale(var(--scale,1));
    transition:transform 700ms cubic-bezier(.16,1,.3,1),filter 700ms ease,opacity 500ms ease,box-shadow 500ms ease;
    animation:prototype-showcase-float 7s ease-in-out infinite;
    will-change:transform;
  }

  .prototype-showcase-card :global(img) {
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    object-position:var(--image-position,50% 50%);
    transform:scale(var(--image-scale,1.08));
    transition:transform 900ms cubic-bezier(.16,1,.3,1);
  }

  .prototype-showcase-card.is-featured {
    --float:-14px;
    --scale:1.075;
    filter:saturate(1.04) contrast(1.015);
    box-shadow:0 32px 65px rgba(44,46,38,.24);
  }

  .prototype-showcase-card:focus-visible { outline:3px solid #4f5a45; outline-offset:5px; }
  .prototype-showcase-card.is-featured :global(img) { transform:scale(calc(var(--image-scale,1.08) + .035)); }
  .prototype-showcase-card.is-web { top:16%; left:10%; width:72%; aspect-ratio:1.16; --rotation:-3.5deg; --depth:4px; --card-radius:30px 15px 30px 15px; --image-position:50% 45%; --image-scale:1.12; }
  .prototype-showcase-card.is-brand { top:0; right:1%; width:44%; aspect-ratio:.88; --rotation:5.5deg; --depth:34px; --card-radius:18px 44px 18px 44px; --image-position:56% 50%; --image-scale:1.2; animation-delay:-1.8s; }
  .prototype-showcase-card.is-design { bottom:0; left:0; width:39%; aspect-ratio:.82; --rotation:-6deg; --depth:54px; --card-radius:48px 18px 48px 18px; --image-position:49% 45%; --image-scale:1.22; animation-delay:-3.4s; }
  .prototype-showcase-card.is-guidance { right:0; bottom:5%; width:46%; aspect-ratio:1.13; --rotation:4deg; --depth:74px; --card-radius:16px 36px 16px 36px; --image-position:52% 48%; --image-scale:1.16; animation-delay:-5.1s; }

  @keyframes prototype-showcase-float {
    0%,100% { translate:0 0; }
    50% { translate:0 -7px; }
  }

  @media(max-width:900px){
    .prototype-showcase{width:min(78vw,560px)}
  }

  @media(max-width:520px){
    .prototype-showcase{width:min(94vw,430px)}
    .prototype-showcase-stage{inset:2%}
    .prototype-showcase-card{box-shadow:0 15px 34px rgba(44,46,38,.16)}
  }

  @media(prefers-reduced-motion:reduce){
    .prototype-showcase-stage{transform:rotateX(-2deg) rotateY(2deg);transition:none}
    .prototype-showcase-card{animation:none;transition:none}
    .prototype-showcase-card.is-featured{--float:0;--scale:1}
    .prototype-showcase-card.is-featured :global(img){transform:scale(var(--image-scale,1.08))}
  }
</style>

<script>
  const showcase = document.querySelector<HTMLElement>("[data-prototype-showcase]");
  const showcaseCards = Array.from(document.querySelectorAll<HTMLElement>("[data-showcase-card]"));
  const showcasePointer = window.matchMedia("(hover:hover) and (pointer:fine)");
  const showcaseReducedMotion = window.matchMedia("(prefers-reduced-motion:reduce)");

  if (showcase && showcaseCards.length > 0) {
    let featuredCard = 0;
    let showcaseTimer = 0;
    const activateCard = (nextCard:number) => {
      featuredCard = nextCard;
      showcaseCards.forEach((card, index) => {
        const distance = (index - featuredCard + showcaseCards.length) % showcaseCards.length;
        card.classList.toggle("is-featured", index === featuredCard);
        card.setAttribute("aria-pressed", index === featuredCard ? "true" : "false");
        card.style.setProperty("--stack-order", `${showcaseCards.length - distance}`);
      });
    };
    const scheduleRotation = () => {
      window.clearInterval(showcaseTimer);
      showcaseTimer = window.setInterval(() => activateCard((featuredCard + 1) % showcaseCards.length), 2800);
    };
    showcaseCards.forEach((card, index) => card.addEventListener("click", () => {
      activateCard(index);
      if (!showcaseReducedMotion.matches) scheduleRotation();
    }));
    activateCard(0);
    if (!showcaseReducedMotion.matches) scheduleRotation();

    if (showcasePointer.matches && !showcaseReducedMotion.matches) {
      let pointerFrame = 0;
      let rotateX = 2;
      let rotateY = -2;
      const renderShowcaseTilt = () => {
        showcase.style.setProperty("--showcase-x", `${rotateX.toFixed(2)}deg`);
        showcase.style.setProperty("--showcase-y", `${rotateY.toFixed(2)}deg`);
        pointerFrame = 0;
      };
      showcase.addEventListener("pointermove", (event) => {
        const bounds = showcase.getBoundingClientRect();
        rotateX = ((event.clientX - bounds.left) / bounds.width - .5) * 6;
        rotateY = ((event.clientY - bounds.top) / bounds.height - .5) * -6;
        if (!pointerFrame) pointerFrame = window.requestAnimationFrame(renderShowcaseTilt);
      });
      showcase.addEventListener("pointerleave", () => {
        rotateX = 2;
        rotateY = -2;
        if (!pointerFrame) pointerFrame = window.requestAnimationFrame(renderShowcaseTilt);
      });
    }
  }
</script>
