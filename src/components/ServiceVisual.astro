---
interface Props {
  type: "web" | "brand" | "ux" | "support";
  label: string;
}

const { type, label } = Astro.props;
---

<div class:list={["service-art", `service-art--${type}`]} aria-hidden="true">
  <div class="art-grid"></div>
  <span class="art-label">{label}</span>
  <div class="art-window">
    <span></span><span></span><span></span>
    <i></i><i></i><i></i>
  </div>
  <div class="art-disc"><strong>Se</strong><i></i></div>
  <div class="art-route"><span></span><i></i><b></b></div>
  <p>DISEÑO <i></i> MARCA <i></i> TECNOLOGÍA</p>
</div>

<style>
  .service-art { position:relative; width:100%; min-height:520px; overflow:hidden; border:1px solid rgba(44,46,38,.18); background:var(--color-stone); color:var(--color-espresso); isolation:isolate; }
  .art-grid { position:absolute; inset:0; z-index:-1; opacity:.4; background:linear-gradient(90deg,transparent 49.8%,rgba(44,46,38,.12) 50%),linear-gradient(transparent 49.8%,rgba(44,46,38,.12) 50%); background-size:84px 84px; }
  .art-label { position:absolute; top:22px; left:24px; font-size:.62rem; font-weight:650; letter-spacing:.12em; text-transform:uppercase; }
  .art-window { position:absolute; top:17%; right:9%; width:66%; height:58%; padding:15%; border:1px solid rgba(44,46,38,.28); border-radius:12px; background:rgba(243,239,231,.76); box-shadow:20px 28px 0 rgba(79,90,69,.18); transform:rotate(2deg); }
  .art-window::before { position:absolute; top:13px; right:13px; left:13px; height:1px; background:rgba(44,46,38,.18); content:""; }
  .art-window span { position:absolute; top:8px; width:5px; height:5px; border-radius:50%; background:var(--color-olive); }
  .art-window span:nth-child(1){left:15px}.art-window span:nth-child(2){left:25px}.art-window span:nth-child(3){left:35px}
  .art-window i { display:block; height:8px; margin-bottom:14px; border-radius:99px; background:var(--color-moss); opacity:.72; }
  .art-window i:nth-of-type(1){width:78%}.art-window i:nth-of-type(2){width:52%}.art-window i:nth-of-type(3){width:66%}
  .art-disc { position:absolute; bottom:12%; left:8%; display:grid; place-items:center; width:33%; aspect-ratio:1; border-radius:50%; background:var(--color-moss); box-shadow:9px 12px 0 var(--color-espresso); color:var(--color-cream); transform:rotate(-8deg); }
  .art-disc strong { font-family:var(--font-heading); font-size:clamp(4rem,8vw,7rem); font-weight:400; letter-spacing:-.08em; }
  .art-disc i { position:absolute; right:20%; bottom:21%; width:9px; height:9px; border-radius:50%; background:var(--color-stone); }
  .art-route { position:absolute; top:27%; left:7%; width:30%; height:1px; background:var(--color-espresso); transform:rotate(-28deg); transform-origin:left; }
  .art-route span,.art-route i,.art-route b { position:absolute; top:-5px; width:11px; height:11px; border:1px solid currentColor; border-radius:50%; background:var(--color-stone); }
  .art-route span{left:0}.art-route i{left:50%}.art-route b{right:0;background:var(--color-espresso)}
  .service-art>p { position:absolute; right:20px; bottom:16px; display:flex; align-items:center; gap:7px; margin:0; font-size:.55rem; font-weight:650; letter-spacing:.1em; }
  .service-art>p i { width:4px; height:4px; border-radius:50%; background:currentColor; }
  .service-art--brand .art-window { top:13%; right:12%; width:48%; height:68%; border-radius:0; transform:rotate(6deg); }
  .service-art--brand .art-window i { height:34px; border-radius:0; background:linear-gradient(90deg,var(--color-moss) 0 32%,var(--color-olive) 32% 65%,var(--color-espresso) 65%); }
  .service-art--brand .art-window i:nth-of-type(2){width:100%;opacity:.45}.service-art--brand .art-window i:nth-of-type(3){width:100%;opacity:.25}
  .service-art--brand .art-disc { width:39%; background:var(--color-cream); color:var(--color-moss); box-shadow:10px 13px 0 var(--color-olive); }
  .service-art--ux .art-window { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; padding:56px 22px 22px; transform:rotate(-2deg); }
  .service-art--ux .art-window i { width:auto!important; height:auto; min-height:70px; margin:0; border:1px solid rgba(44,46,38,.16); border-radius:7px; background:rgba(107,116,92,.23); }
  .service-art--ux .art-window i:first-of-type { grid-row:span 2; }
  .service-art--ux .art-disc { width:27%; }
  .service-art--support .art-window { top:11%; right:7%; width:58%; height:64%; border-radius:50%; background:transparent; box-shadow:none; }
  .service-art--support .art-window::before { inset:16%; height:auto; border:1px dashed rgba(44,46,38,.26); border-radius:50%; background:none; }
  .service-art--support .art-window i { position:absolute; width:13px!important; height:13px; margin:0; border-radius:50%; background:var(--color-moss); }
  .service-art--support .art-window i:nth-of-type(1){top:7%;left:47%}.service-art--support .art-window i:nth-of-type(2){right:8%;bottom:30%}.service-art--support .art-window i:nth-of-type(3){bottom:4%;left:28%}
  @media(max-width:760px){.service-art{min-height:430px}.art-window{right:6%;width:72%}.art-disc{width:38%}.service-art--brand .art-window{width:52%}.service-art--support .art-window{width:68%}}
  @media(max-width:420px){.service-art{min-height:360px}.art-grid{background-size:62px 62px}.art-window{height:55%}.art-disc{bottom:14%;width:42%}.service-art--brand .art-window{height:66%}.service-art>p{display:none}}
</style>
