---
import { CONTACT_EMAIL } from "../config/contact";

const currentYear=new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-shell">
    <div class="footer-top"><a href="#inicio">Sael<i></i>Estudio</a><p>Diseño + soluciones</p></div>
    <div class="footer-word" aria-hidden="true">SAEL</div>
    <div class="footer-bottom"><p>© {currentYear} Sael Estudio</p><div><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><a href="#">Instagram</a><a href="#">WhatsApp</a></div><a href="#inicio">Arriba ↑</a></div>
  </div>
</footer>
<style>
  .site-footer { overflow:hidden; background:var(--color-espresso); color:var(--color-cream); }
  .footer-shell { padding-top:clamp(70px,8vw,112px); }
  .footer-top { display:flex; align-items:center; justify-content:space-between; gap:30px; }
  .footer-top > a { display:flex; align-items:center; gap:9px; font-family:var(--font-heading); font-size:2rem; font-weight:600; letter-spacing:-.06em; }
  .footer-top i { width:5px; height:5px; border-radius:50%; background:currentColor; }
  .footer-top p { margin:0; color:rgba(243,239,231,.58); font-size:var(--font-size-ui); }
  .footer-word { margin:clamp(90px,11vw,170px) 0 clamp(20px,2.4vw,38px); font-family:var(--font-heading); font-size:clamp(8rem,27.5vw,25rem); font-weight:650; line-height:.67; letter-spacing:-.095em; }
  .footer-bottom { min-height:86px; display:grid; grid-template-columns:1fr auto 1fr; gap:24px; align-items:center; border-top:1px solid rgba(243,239,231,.15); }
  .footer-bottom p { margin:0; color:rgba(243,239,231,.48); font-size:var(--font-size-meta); }
  .footer-bottom div { display:flex; gap:22px; }
  .footer-bottom a { color:rgba(243,239,231,.68); font-size:var(--font-size-meta); }
  .footer-bottom > a { justify-self:end; }
  @media (max-width:600px) {
    .footer-shell { padding-bottom:max(18px,env(safe-area-inset-bottom)); }
    .footer-top { align-items:flex-start; }
    .footer-word { margin-top:82px; font-size:31vw; }
    .footer-bottom { grid-template-columns:minmax(0,1fr) auto; grid-template-rows:auto auto; gap:22px 14px; min-height:0; padding:26px 0 max(34px,calc(env(safe-area-inset-bottom) + 22px)); }
    .footer-bottom div { grid-column:1/-1; grid-row:1; flex-wrap:wrap; row-gap:10px; }
    .footer-bottom p { grid-column:1; grid-row:2; }
    .footer-bottom > a { grid-column:2; grid-row:2; }
  }
</style>
