---
const currentYear = new Date().getFullYear();

const navigation = [
  { label: "Inicio", href: "#inicio" },
  { label: "Sobre Sael", href: "#sobre-sael" },
  { label: "Servicios", href: "#servicios" },
  { label: "Proceso", href: "#proceso" },
  { label: "Contacto", href: "#contacto" },
];
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="#inicio" aria-label="Volver al inicio">
          <span class="brand-name">Sael</span>
          <span class="brand-detail">Estudio</span>
        </a>

        <p>
          Identidad, diseño y acompañamiento creativo.
        </p>
      </div>

      <nav class="footer-navigation" aria-label="Navegación del pie de página">
        <p class="footer-column-title">Navegación</p>

        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-contact">
        <p class="footer-column-title">Contacto</p>

        <a href="mailto:contacto@saelestudio.com">
          contacto@saelestudio.com
        </a>

        <a href="#">Instagram</a>
        <a href="#">WhatsApp</a>
      </div>
    </div>

    <div class="footer-statement">
      <p>
        Diseño con intención.
        <span>Marcas con alma.</span>
      </p>
    </div>

    <div class="footer-bottom">
      <p>
        © {currentYear} Sael Estudio. Todos los derechos reservados.
      </p>

      <div class="footer-symbol" aria-hidden="true">
        <span></span>
        <i></i>
        <span></span>
      </div>

      <a href="#inicio">
        Volver arriba
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-espresso);
    color: var(--color-cream);
  }

  .footer-container {
    padding-top: clamp(72px, 10vw, 130px);
    padding-bottom: 30px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(260px, 1.2fr) 0.7fr 0.8fr;
    gap: clamp(48px, 8vw, 120px);
    padding-bottom: clamp(70px, 10vw, 130px);
  }

  .footer-brand > a {
    display: inline-flex;
    align-items: baseline;
    gap: 9px;
    margin-bottom: 24px;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .brand-detail {
    color: rgba(243, 239, 231, 0.62);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer-brand p {
    max-width: 370px;
    margin-bottom: 0;
    color: rgba(243, 239, 231, 0.65);
    line-height: 1.7;
  }

  .footer-column-title {
    margin-bottom: 24px;
    color: rgba(243, 239, 231, 0.5);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-navigation ul {
    display: flex;
    flex-direction: column;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-navigation a,
  .footer-contact a {
    color: rgba(243, 239, 231, 0.78);
    transition: color var(--transition-fast);
  }

  .footer-navigation a:hover,
  .footer-contact a:hover {
    color: var(--color-cream);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
  }

  .footer-contact .footer-column-title {
    margin-bottom: 11px;
  }

  .footer-statement {
    padding-block: clamp(56px, 8vw, 92px);
    border-top: 1px solid rgba(243, 239, 231, 0.16);
    border-bottom: 1px solid rgba(243, 239, 231, 0.16);
  }

  .footer-statement p {
    max-width: 1100px;
    margin-bottom: 0;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .footer-statement span {
    display: block;
    color: var(--color-stone);
    font-style: italic;
  }

  .footer-bottom {
    min-height: 90px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 30px;
    align-items: center;
  }

  .footer-bottom p {
    margin-bottom: 0;
    color: rgba(243, 239, 231, 0.48);
    font-size: 0.72rem;
  }

  .footer-bottom > a {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: rgba(243, 239, 231, 0.72);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-bottom > a span {
    transition: transform var(--transition-fast);
  }

  .footer-bottom > a:hover span {
    transform: translateY(-3px);
  }

  .footer-symbol {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-symbol span {
    width: 28px;
    height: 1px;
    background-color: rgba(243, 239, 231, 0.3);
  }

  .footer-symbol i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-stone);
  }

  @media (max-width: 800px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .brand-name {
      font-size: 2.5rem;
    }

    .footer-statement p {
  font-size: clamp(2.8rem, 14vw, 4.4rem);
}

    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 22px;
      padding-block: 28px;
    }

    .footer-symbol {
      grid-row: 1;
    }

    .footer-bottom > a {
      justify-self: start;
    }
  }
</style>