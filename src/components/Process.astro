---
const steps = [
  { title:"Escuchar", text:"Entender la necesidad real." },
  { title:"Enfocar", text:"Definir qué importa." },
  { title:"Diseñar", text:"Convertir estrategia en forma." },
  { title:"Construir", text:"Probar, ajustar y resolver." },
  { title:"Acompañar", text:"Entregar y seguir avanzando." },
];
---

<section id="proceso" class="process" aria-labelledby="process-title">
  <div class="process-motion" data-scroll-linked aria-hidden="true">
    <span></span><i></i><b></b>
  </div>
  <div class="container process-shell">
    <div class="process-heading">
      <p class="section-label" data-reveal>Cómo trabajamos</p>
      <h2 id="process-title" data-reveal="mask">Claridad para<br />moverse mejor.</h2>
    </div>

    <ol class="process-steps">
      {steps.map((step,index)=>(
        <li data-reveal style={`--reveal-delay:${index*60}ms`}>
          <span>0{index+1}</span><h3>{step.title}</h3><p>{step.text}</p><i aria-hidden="true"></i>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { position:relative; overflow:hidden; padding-block:clamp(110px,13vw,190px); background:var(--color-cream); }
  .process-shell { position:relative; z-index:1; }
  .process-motion { position:absolute; top:8%; right:-8vw; width:min(42vw,590px); aspect-ratio:1; border:1px solid rgba(79,90,69,.2); border-radius:50%; transform:translateY(var(--scroll-inverse-offset,-80px)) rotate(var(--scroll-rotate,0deg)); will-change:transform; }
  .process-motion::before { content:""; position:absolute; inset:17%; border:1px solid rgba(79,90,69,.16); border-radius:50%; }
  .process-motion span { position:absolute; top:50%; right:-10%; left:-10%; height:1px; background:rgba(79,90,69,.25); }
  .process-motion i { position:absolute; top:calc(50% - 7px); left:16%; width:14px; height:14px; border-radius:50%; background:var(--color-moss); animation:process-node 4s var(--ease-in-out) infinite alternate; }
  .process-motion b { position:absolute; right:17%; bottom:20%; width:20%; aspect-ratio:1; border:1px solid rgba(79,90,69,.28); transform:rotate(45deg); animation:process-shape 8s var(--ease-in-out) infinite alternate; }
  .process-heading { display:grid; grid-template-columns:.32fr 1fr; gap:clamp(60px,8vw,130px); }
  .process-heading h2 { margin:0; font-size:clamp(5rem,8.7vw,9rem); font-weight:500; line-height:.79; letter-spacing:-.07em; }
  .process-steps { margin:clamp(90px,12vw,170px) 0 0; padding:0; list-style:none; border-top:1px solid rgba(44,46,38,.22); }
  .process-steps li { position:relative; display:grid; grid-template-columns:64px 1fr 1fr 22px; gap:24px; align-items:center; min-height:126px; border-bottom:1px solid rgba(44,46,38,.22); overflow:hidden; }
  .process-steps li::before { content:""; position:absolute; inset:0; background:var(--color-stone); transform:translateY(102%); transition:transform 650ms var(--ease-out); }
  .process-steps li:hover::before { transform:none; }
  .process-steps span,.process-steps h3,.process-steps p,.process-steps i { position:relative; z-index:1; }
  .process-steps span { font-size:var(--font-size-meta); opacity:.58; }
  .process-steps h3 { margin:0; font-size:clamp(2.6rem,4.2vw,5rem); font-weight:500; letter-spacing:-.055em; transition:transform 650ms var(--ease-out); }
  .process-steps p { margin:0; color:rgba(44,46,38,.58); transition:transform 650ms var(--ease-out),color 450ms ease; }
  .process-steps i { width:10px; height:10px; border-radius:50%; background:var(--color-moss); transform:scale(.45); transition:transform 600ms var(--ease-out); }
  .process-steps li:hover i { transform:scale(1); }
  .process-steps li:hover h3 { transform:translateX(16px); }
  .process-steps li:hover p { color:var(--color-espresso); transform:translateX(-8px); }
  @keyframes process-node { to { left:76%; transform:scale(1.35); } }
  @keyframes process-shape { to { transform:rotate(135deg) scale(.72); } }
  @media (max-width:760px) { .process-motion { top:18%; right:-35vw; width:95vw; opacity:.65; } .process-heading { grid-template-columns:1fr; gap:38px; } .process-heading h2 { font-size:clamp(4.3rem,17vw,5.8rem); } .process-steps { margin-top:72px; } .process-steps li { grid-template-columns:34px 1fr 12px; gap:14px; min-height:112px; } .process-steps p { grid-column:2; margin-top:-20px; font-size:.92rem; } .process-steps i { grid-column:3; grid-row:1/3; } }
  @media (prefers-reduced-motion:reduce) { .process-motion { transform:none; } .process-motion i,.process-motion b { animation:none; } }
</style>
