---
import ArrowIcon from "../ArrowIcon.astro";
import HomeHeader from "./HomeHeader.astro";
import ServiceShowcase from "./ServiceShowcase.astro";
import { createWhatsAppUrl, PROJECT_WHATSAPP_MESSAGE } from "../../config/contact";

const whatsappUrl=createWhatsAppUrl(PROJECT_WHATSAPP_MESSAGE);
const phrases=["sitios web.","aplicaciones.","identidades.","soluciones digitales."];
---
<script is:inline>
  if("scrollRestoration" in history)history.scrollRestoration="manual";
  document.documentElement.classList.add("home-motion-ready");
  if(!location.hash)addEventListener("pageshow",()=>scrollTo(0,0),{once:true});
</script>

<HomeHeader />
<section class="home-intro" data-home-intro aria-label="Entrada de Sael Estudio">
  <div class="home-intro-stage" data-home-intro-stage>
    <div class="home-intro-brand-transform home-intro-brand-transform--light"><p class="home-intro-brand" data-home-intro-brand aria-label="Sael Estudio"><span>Sael</span><i aria-hidden="true"></i><small>Estudio</small></p></div>
    <div class="home-intro-wipe" aria-hidden="true"></div>
    <div class="home-intro-brand-transform home-intro-brand-transform--dark" aria-hidden="true"><p class="home-intro-brand"><span>Sael</span><i></i><small>Estudio</small></p></div>
    <p class="home-scroll-hint"><span aria-hidden="true"></span>Deslizá para descubrir</p>
  </div>
</section>

<main id="main-content" class="home-v3" data-home-root tabindex="-1">
  <section class="home-hero" data-home-hero aria-labelledby="home-title">
    <div class="home-hero-light" aria-hidden="true"></div>
    <div class="home-hero-shell">
      <div class="home-hero-copy">
        <p class="home-kicker">Estudio de diseño y tecnología · Uruguay</p>
        <h1 id="home-title" aria-label="Diseñamos y desarrollamos soluciones digitales."><span class="home-stable-line" aria-hidden="true">Diseñamos y desarrollamos</span><span class="home-variable-lines" data-home-phrases aria-hidden="true">{phrases.map((phrase,index)=><span class:list={["home-variable-phrase",{"is-active":index===phrases.length-1}]} data-home-phrase>{phrase}</span>)}</span></h1>
        <p class="home-description">Desde una identidad y sus primeros canales hasta una web, una app o un sistema completo. Construimos contigo la solución que tu proyecto necesita.</p>
        <div class="home-actions"><a class="home-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Contanos tu proyecto <ArrowIcon /></a><a class="home-secondary" href="#proyectos">Ver proyectos <ArrowIcon /></a></div>
      </div>
      <div class="home-hero-object"><ServiceShowcase /></div>
    </div>
  </section>
  <slot />
</main>

<style>
  @font-face{font-family:"Bricolage Grotesque";src:url("/fonts/bricolage-grotesque-latin.woff2") format("woff2");font-style:normal;font-weight:200 800;font-display:swap}
  :global(body:has(.home-v3)){background:#f3efe7;font-family:Manrope,Arial,sans-serif}:global(body.home-menu-open){overflow:hidden}.home-v3{--font-heading:"Bricolage Grotesque",Arial,sans-serif;overflow:clip;background:#f3efe7;color:#2c2e26}.home-v3 :is(h1,h2,h3){font-family:var(--font-heading);font-style:normal}
  .home-intro{display:none}:global(html.home-motion-ready) .home-intro{position:relative;z-index:1;display:block;height:145svh;background:#4f5a45}:global(html.home-intro-skip) .home-intro{display:none}
  .home-intro-stage{--intro-clip:100%;--brand-x:0px;--brand-y:0px;--brand-scale:1;--brand-opacity:1;--hint-opacity:1;position:sticky;top:0;height:100svh;overflow:hidden;background:#4f5a45}.home-intro-stage::before{position:absolute;inset:7%;border-radius:50%;background:radial-gradient(circle,rgba(107,116,92,.36),transparent 68%);content:""}.home-intro-wipe{position:absolute;inset:0;z-index:2;background:#f3efe7;clip-path:inset(0 0 var(--intro-clip) 0);will-change:clip-path}.home-intro-brand-transform{position:absolute;inset:0;z-index:1;opacity:var(--brand-opacity);animation:home-brand-enter 2200ms cubic-bezier(.22,.76,.24,1) both;will-change:transform,opacity}.home-intro-brand-transform--dark{z-index:3;color:#4f5a45;clip-path:inset(0 0 var(--intro-clip) 0);will-change:clip-path,transform,opacity}.home-intro-brand-transform--light{color:#f3efe7}.home-intro-brand{position:absolute;top:50%;left:50%;width:calc(100% - clamp(20px,2.8vw,52px));display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;column-gap:.045em;margin:0;opacity:1;white-space:nowrap;font:650 clamp(4.6rem,25.5vw,56rem)/.74 "Bricolage Grotesque",Arial,sans-serif;letter-spacing:-.075em;animation:home-brand-appear 2200ms cubic-bezier(.22,.76,.24,1) both;transform:translate(-50%,-50%) translate3d(var(--brand-x),var(--brand-y),0) scale(var(--brand-scale));transform-origin:left top;will-change:transform,opacity}.home-intro-brand>span{justify-self:end}.home-intro-brand i{width:.045em;height:.045em;justify-self:center;border-radius:50%;background:#6b745c}.home-intro-brand-transform--light i{background:#d8d2c4}.home-intro-brand small{justify-self:start;font:inherit;font-size:.55em;line-height:.82;letter-spacing:-.055em}.home-scroll-hint{position:absolute;bottom:max(26px,env(safe-area-inset-bottom));left:50%;z-index:4;display:flex;align-items:center;gap:12px;margin:0;color:rgba(243,239,231,.76);opacity:var(--hint-opacity);font-size:.65rem;font-weight:650;letter-spacing:.07em;text-transform:uppercase;transform:translateX(-50%)}.home-scroll-hint span{width:34px;height:1px;background:currentColor;transform-origin:left;animation:home-hint 1.8s ease-in-out infinite}
  .home-hero{position:relative;z-index:2;min-height:100svh;padding:clamp(94px,8vw,124px) 0 clamp(154px,14vw,210px);background:#f3efe7}:global(html.home-motion-ready) .home-hero{min-height:108svh;margin-top:-80svh;clip-path:inset(100% 0 0);transition:clip-path 720ms cubic-bezier(.16,1,.3,1)}:global(html.home-motion-ready) .home-hero.is-entering{clip-path:inset(0)}:global(html.home-intro-skip) .home-hero{margin-top:0;clip-path:none}.home-hero-light{position:absolute;top:6%;right:-15%;width:58vw;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(216,210,196,.62),rgba(243,239,231,0) 68%);pointer-events:none}.home-hero-shell{position:relative;z-index:1;width:min(calc(100% - 80px),1340px);display:grid;grid-template-columns:minmax(0,1.12fr) minmax(440px,.72fr);gap:clamp(42px,6vw,96px);align-items:center;margin-inline:auto}.home-hero-copy{min-width:0}.home-kicker{margin:0 0 28px;color:#4f5a45;font-size:.69rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.home-hero h1{margin:0;font-weight:600;letter-spacing:-.065em}.home-stable-line{display:block;max-width:780px;font-size:clamp(2.9rem,4.6vw,5.1rem);line-height:.9}.home-variable-lines{position:relative;width:100%;min-width:0;display:grid;min-height:clamp(8.5rem,13vw,12.5rem);margin-top:14px}.home-variable-phrase{grid-area:1/1;align-self:start;max-width:100%;visibility:hidden;opacity:0;font-size:clamp(4.5rem,6.7vw,7.1rem);line-height:.8;transition:opacity 420ms ease,transform 620ms cubic-bezier(.16,1,.3,1);transform:translateY(.18em)}.home-variable-phrase:last-child,.home-variable-lines.is-looping .home-variable-phrase.is-active{visibility:visible;opacity:1;transform:none}.home-variable-lines.is-looping .home-variable-phrase:last-child:not(.is-active){visibility:hidden;opacity:0;transform:translateY(-.12em)}.home-description{max-width:670px;margin:24px 0 0;font-size:clamp(1rem,1.15vw,1.14rem);line-height:1.7}.home-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.home-primary,.home-secondary{min-height:52px;display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:0 20px;border:1px solid #2c2e26;border-radius:999px;font-size:.78rem;font-weight:700;transition:background 220ms ease,color 220ms ease,transform 220ms ease}.home-primary{background:#2c2e26;color:#f3efe7}.home-primary:hover,.home-primary:focus-visible{background:#4f5a45;border-color:#4f5a45;transform:translateY(-3px)}.home-secondary:hover,.home-secondary:focus-visible{background:#2c2e26;color:#f3efe7;transform:translateY(-3px)}.home-hero-object{display:grid;place-items:center}
  @keyframes home-brand-enter{0%{transform:translate3d(0,-108%,0) scale(1.08)}12%{transform:translate3d(0,-88%,0) scale(1.068)}72%{transform:translate3d(0,1.1%,0) scale(1.006)}88%{transform:translate3d(0,-.22%,0) scale(.998)}100%{transform:none}}@keyframes home-brand-appear{0%{opacity:0}12%,100%{opacity:1}}@keyframes home-hint{0%,100%{transform:scaleX(.28);opacity:.45}50%{transform:scaleX(1);opacity:1}}
  @media(max-width:1050px){.home-hero-shell{grid-template-columns:minmax(0,1fr) minmax(350px,.7fr);width:min(calc(100% - 48px),960px);gap:28px}.home-variable-lines{min-height:clamp(8.5rem,16vw,11.8rem)}}
  @media(max-width:800px){:global(html.home-motion-ready) .home-intro{height:140svh}.home-hero,:global(html.home-motion-ready) .home-hero{min-height:auto;padding:96px 0 168px}:global(html.home-motion-ready) .home-hero{margin-top:-72svh}.home-hero-shell{grid-template-columns:1fr;width:min(calc(100% - 40px),720px);gap:48px}.home-stable-line{font-size:clamp(2.8rem,8vw,4.5rem)}.home-variable-lines{min-height:clamp(8.3rem,25vw,12rem)}.home-variable-phrase{font-size:clamp(4.8rem,14vw,7.5rem)}.home-hero-object{grid-row:2}}
  @media(max-width:520px){:global(html.home-motion-ready) .home-intro{height:138svh}.home-intro-brand{letter-spacing:-.08em}.home-scroll-hint{width:max-content;font-size:.58rem}.home-hero,:global(html.home-motion-ready) .home-hero{padding:84px 0 150px}:global(html.home-motion-ready) .home-hero{margin-top:-72svh}.home-hero-shell{width:calc(100% - 36px);gap:38px}.home-kicker{margin-bottom:23px;font-size:.61rem}.home-stable-line{font-size:clamp(2.55rem,12.3vw,3.45rem);line-height:.88}.home-variable-lines{min-height:clamp(8rem,43vw,10.8rem);margin-top:12px}.home-variable-phrase{font-size:clamp(3.35rem,14.7vw,4.15rem);line-height:.82}.home-description{margin-top:22px;font-size:.98rem;line-height:1.65}.home-actions{display:grid;grid-template-columns:1fr;margin-top:24px}.home-primary,.home-secondary{width:100%}}
  @media(prefers-reduced-motion:reduce){.home-intro-brand-transform,.home-intro-brand,.home-hero,.home-scroll-hint span,.home-variable-phrase,.home-primary,.home-secondary{animation:none;transition:none}}
</style>

<script>
  const root=document.querySelector<HTMLElement>("[data-home-root]");const intro=document.querySelector<HTMLElement>("[data-home-intro]");const stage=document.querySelector<HTMLElement>("[data-home-intro-stage]");const brand=document.querySelector<HTMLElement>("[data-home-intro-brand]");const hero=document.querySelector<HTMLElement>("[data-home-hero]");const header=document.querySelector<HTMLElement>("[data-home-header]");const target=document.querySelector<HTMLElement>("[data-home-wordmark-target]");const phraseWrap=document.querySelector<HTMLElement>("[data-home-phrases]");const phraseItems=Array.from(document.querySelectorAll<HTMLElement>("[data-home-phrase]"));const reduced=window.matchMedia("(prefers-reduced-motion:reduce)");let skip=false;
  const settleIntro=()=>{skip=true;document.documentElement.classList.remove("home-motion-ready");document.documentElement.classList.add("home-intro-skip");header?.setAttribute("data-visible","true");header?.setAttribute("data-brand-visible","true");header?.setAttribute("data-framed","true");hero?.classList.add("is-entering")};
  if(location.hash==="#main-content"){settleIntro();requestAnimationFrame(()=>scrollTo(0,0))}
  document.querySelector<HTMLAnchorElement>('.skip-link[href="#main-content"]')?.addEventListener("click",()=>{settleIntro();requestAnimationFrame(()=>scrollTo(0,0))});
  if(root&&intro&&stage&&brand&&header&&target&&!skip){let frame=0,x=0,y=0,scale=.1,entryReleased=false;const entryAnimations=Array.from(stage.querySelectorAll<HTMLElement>(".home-intro-brand-transform,.home-intro-brand")).flatMap(element=>typeof element.getAnimations==="function"?element.getAnimations():[]);const releaseEntry=()=>{if(entryReleased||scrollY<=1)return;entryReleased=true;entryAnimations.forEach(animation=>{if(animation.playState!=="finished")animation.playbackRate=3})};const measure=()=>{const box=target.getBoundingClientRect();const left=(innerWidth-brand.offsetWidth)/2;const top=(innerHeight-brand.offsetHeight)/2;x=box.left-left;y=box.top-top;scale=Math.max(.055,Math.min(.18,box.width/brand.offsetWidth))};const render=()=>{releaseEntry();const travel=Math.max(1,intro.offsetHeight-innerHeight);const progress=Math.max(0,Math.min(1,scrollY/travel));const move=Math.max(0,Math.min(1,(progress-.04)/.52));const eased=move*move*(3-2*move);const invert=Math.max(0,Math.min(1,(progress-.08)/.36));const fade=Math.max(0,Math.min(1,(progress-.58)/.14));const hint=Math.max(0,Math.min(1,progress/.24));stage.style.setProperty("--brand-x",`${(x*eased).toFixed(2)}px`);stage.style.setProperty("--brand-y",`${(y*eased).toFixed(2)}px`);stage.style.setProperty("--brand-scale",`${1-(1-scale)*eased}`);stage.style.setProperty("--intro-clip",`${((1-invert)*100).toFixed(2)}%`);stage.style.setProperty("--brand-opacity",`${1-fade}`);stage.style.setProperty("--hint-opacity",`${1-hint}`);header.dataset.visible=progress>=.46?"true":"false";header.dataset.brandVisible=fade>=1?"true":"false";header.dataset.framed=progress>=.74?"true":"false";hero?.classList.toggle("is-entering",progress>=.42);frame=0};const request=()=>{if(!frame)frame=requestAnimationFrame(render)};measure();render();addEventListener("scroll",request,{passive:true});addEventListener("resize",()=>{measure();request()})}
  if(phraseWrap&&phraseItems.length&&!reduced.matches){let active=phraseItems.length-1;phraseWrap.classList.add("is-looping");setInterval(()=>{phraseItems[active]?.classList.remove("is-active");active=(active+1)%phraseItems.length;phraseItems[active]?.classList.add("is-active")},2000)}
</script>
