---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MotionController from "../../components/MotionController.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import ServiceVisual from "../../components/ServiceVisual.astro";
import { createWhatsAppUrl, GENERAL_WHATSAPP_MESSAGE } from "../../config/contact";
import { SITE_URL, services, servicePath } from "../../config/site";

const whatsappUrl = createWhatsAppUrl(GENERAL_WHATSAPP_MESSAGE);
const pageUrl = `${SITE_URL}/servicios/`;
const schema = {
  "@type": "CollectionPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Servicios de diseño, identidad y desarrollo digital | Sael Estudio",
  description:
    "Servicios de diseño web, aplicaciones, software, identidad visual, UX/UI y acompañamiento digital para proyectos en Uruguay.",
  isPartOf: { "@id": `${SITE_URL}/#website` },
  about: { "@id": `${SITE_URL}/#organization` },
  inLanguage: "es-UY",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: services.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE_URL}${servicePath(service.slug)}`,
      name: service.title,
    })),
  },
};
---

<BaseLayout
  title="Servicios de diseño, identidad y desarrollo digital | Sael Estudio"
  description="Servicios de diseño web, aplicaciones, software, identidad visual, UX/UI y acompañamiento digital para proyectos en Uruguay."
  schema={schema}
>
  <Header />

  <main id="main-content" tabindex="-1" class="services-page">
    <section class="services-intro" aria-labelledby="services-title">
      <div class="container intro-shell">
        <div>
          <nav class="breadcrumbs" aria-label="Migas de pan">
            <a href="/">Inicio</a><span aria-hidden="true">/</span><span>Servicios</span>
          </nav>
          <p class="eyebrow">Servicios</p>
          <h1 id="services-title">Ideas claras.<br /><em>Formas propias.</em><br />Soluciones útiles.</h1>
        </div>
        <div class="intro-note">
          <p>Combinamos diseño, marca y tecnología para construir presencias y herramientas digitales que se sientan coherentes de principio a fin.</p>
          <a class="button-primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Contanos tu proyecto <ArrowIcon /></a>
        </div>
      </div>
    </section>

    <section class="services-directory" aria-label="Directorio de servicios">
      <div class="container">
        <ol>
          {services.map((service) => (
            <li data-reveal>
              <a href={servicePath(service.slug)}>
                <span class="service-number">{service.number}</span>
                <div class="service-copy">
                  <p>{service.eyebrow}</p>
                  <h2>{service.title}</h2>
                  <strong>{service.summary}</strong>
                </div>
                <div class="service-art" aria-hidden="true">
                  <ServiceVisual type={service.visual} label={service.title} />
                </div>
                <span class="service-link">Conocer el servicio <ArrowIcon /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="services-principle" aria-labelledby="principle-title">
      <div class="container principle-shell">
        <p class="section-label">Cómo trabajamos</p>
        <div>
          <h2 id="principle-title">El alcance adecuado, en el orden adecuado.</h2>
          <p>No todos los proyectos necesitan todo al mismo tiempo. Primero entendemos el punto de partida y después definimos una combinación de servicios proporcional al objetivo.</p>
          <a class="button-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Empezar una conversación <ArrowIcon /></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MotionController />
</BaseLayout>

<style>
  .services-page { background:var(--color-cream); }
  .services-intro { padding:calc(var(--header-height) + 95px) 0 clamp(100px,12vw,180px); background:linear-gradient(125deg,var(--color-cream) 42%,var(--color-stone)); }
  .intro-shell { display:grid; grid-template-columns:1.25fr .55fr; gap:clamp(55px,9vw,145px); align-items:end; }
  .breadcrumbs { display:flex; gap:8px; margin-bottom:54px; color:rgba(44,46,38,.58); font-size:.68rem; }
  .breadcrumbs a { text-decoration:underline; text-underline-offset:3px; }
  .services-intro h1 { margin:32px 0 0; font-size:clamp(5.2rem,9.5vw,10rem); font-weight:400; line-height:.76; letter-spacing:-.05em; }
  .services-intro h1 em { color:var(--color-moss); font-weight:400; }
  .intro-note { padding-bottom:10px; }
  .intro-note p { margin:0; font-size:clamp(1rem,1.25vw,1.18rem); line-height:1.75; }
  .intro-note .button-primary { margin-top:32px; }
  .services-directory { padding-block:clamp(90px,11vw,160px); }
  .services-directory ol { margin:0; padding:0; list-style:none; border-top:1px solid rgba(44,46,38,.24); }
  .services-directory li { border-bottom:1px solid rgba(44,46,38,.24); }
  .services-directory li>a { display:grid; grid-template-columns:55px minmax(0,1fr) minmax(220px,.45fr); grid-template-rows:1fr auto; column-gap:clamp(30px,5vw,80px); min-height:360px; padding:42px 0 30px; }
  .service-number { color:var(--color-olive); font-size:.68rem; font-weight:650; }
  .service-copy>p { margin:0 0 18px; color:var(--color-olive); font-size:.69rem; font-weight:650; letter-spacing:.08em; text-transform:uppercase; }
  .service-copy h2 { max-width:750px; margin:0; font-size:clamp(3.8rem,6.5vw,7.4rem); font-style:italic; font-weight:400; line-height:.82; transition:color var(--transition-normal),transform var(--transition-normal); }
  .service-copy strong { display:block; max-width:610px; margin-top:30px; color:rgba(44,46,38,.7); font-size:.9rem; font-weight:400; line-height:1.65; }
  .service-art { grid-row:1 / 3; grid-column:3; align-self:center; width:100%; transition:transform 650ms var(--ease-out); }
  .service-link { grid-column:2; align-self:end; width:max-content; display:inline-flex; align-items:center; gap:20px; margin-top:28px; border-bottom:1px solid currentColor; padding-bottom:5px; font-size:.76rem; font-weight:650; }
  .services-directory a:hover h2,.services-directory a:focus-visible h2 { color:var(--color-moss); transform:translateX(8px); }
  .services-directory a:hover .service-art,.services-directory a:focus-visible .service-art { transform:rotate(2deg) scale(1.02); }
  .services-principle { padding-block:clamp(105px,13vw,190px); background:var(--color-moss); color:var(--color-cream); }
  .principle-shell { display:grid; grid-template-columns:.3fr 1fr; gap:clamp(50px,9vw,145px); }
  .services-principle .section-label { color:rgba(243,239,231,.7); }
  .services-principle h2 { max-width:950px; margin:0; font-size:clamp(4.5rem,8vw,8.4rem); font-style:italic; font-weight:400; line-height:.8; letter-spacing:-.045em; }
  .services-principle div>p { max-width:610px; margin:38px 0 0; color:rgba(243,239,231,.7); line-height:1.75; }
  .services-principle .button-secondary { margin-top:32px; }
  .services-principle .button-secondary:hover,.services-principle .button-secondary:focus-visible { background:var(--color-cream); color:var(--color-espresso); }
  @media(max-width:980px){.intro-shell{grid-template-columns:1fr}.intro-note{max-width:620px}.services-directory li>a{grid-template-columns:45px 1fr 240px}.principle-shell{grid-template-columns:1fr;gap:42px}}
  @media(max-width:720px){.services-intro{padding-top:calc(var(--header-height) + 60px)}.services-intro h1{font-size:clamp(4.2rem,16vw,6.2rem)}.services-directory li>a{grid-template-columns:34px 1fr;grid-template-rows:auto;min-height:0;padding-block:34px}.service-copy h2{font-size:clamp(3rem,13vw,4.8rem)}.service-copy strong{margin-top:20px}.service-art{grid-column:2;grid-row:auto;width:min(82%,330px);margin:30px 0}.service-link{grid-column:2}.services-principle h2{font-size:clamp(4rem,15vw,6.5rem)}}
  @media(max-width:390px){.services-intro h1{font-size:3.8rem}.service-copy h2{font-size:2.9rem}.services-principle h2{font-size:3.7rem}}
  @media(prefers-reduced-motion:reduce){.service-copy h2,.service-art{transition:none}}
</style>
