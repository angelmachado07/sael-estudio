---
import "../styles/global.css";
import { CONTACT_EMAIL, INSTAGRAM_URL, WHATSAPP_NUMBER } from "../config/contact";
import {
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  SITE_NAME,
  SITE_URL,
} from "../config/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  robots?: string;
  canonicalPath?: string;
  headingFont?: "instrument" | "bricolage";
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  schemas?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Diseño web, identidad y software en Uruguay | Sael Estudio",
  description = "Estudio de diseño y tecnología en Uruguay. Creamos identidades, sitios web, aplicaciones y sistemas para marcas, profesionales y negocios.",
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  ogType = "website",
  robots = "index,follow",
  canonicalPath = Astro.url.pathname,
  headingFont = "instrument",
  schema,
  schemas,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).toString();
const absoluteOgImage = new URL(ogImage, SITE_URL).toString();
const schemaItems = [schema, schemas]
  .flatMap((item) => (Array.isArray(item) ? item : item ? [item] : []))
  .map(({ "@context": _context, ...item }) => item);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      logo: {
        "@type": "ImageObject",
        "@id": `${SITE_URL}/#logo`,
        url: `${SITE_URL}/brand/sael-monogram-official-transparent.png`,
        contentUrl: `${SITE_URL}/brand/sael-monogram-official-transparent.png`,
      },
      image: absoluteOgImage,
      email: CONTACT_EMAIL,
      telephone: WHATSAPP_NUMBER,
      sameAs: [INSTAGRAM_URL],
      areaServed: { "@type": "Country", name: "Uruguay" },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      inLanguage: "es-UY",
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    ...schemaItems,
  ],
};
const serializedSchema = JSON.stringify(structuredData).replace(/</g, "\\u003c");
const headingFontHref = headingFont === "bricolage"
  ? "/fonts/bricolage-grotesque-latin.woff2"
  : "/fonts/instrument-serif-regular-latin.woff2";
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F3EFE7" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFontHref} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={serializedSchema}></script>
    <title>{title}</title>
  </head>

  <body data-path={Astro.url.pathname}>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <slot />
  </body>
</html>
